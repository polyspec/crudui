  {
    "name": "format-date",
    "note": "date format applies the declared pattern.",
    "spec": {
      "fields": {
        "joined": {
          "field": ".joined",
          "label": "Joined",
          "format": {
            "type": "date",
            "pattern": "YYYY-MM-DD"
          }
        }
      }
    },
    "record": {
      "id": 7,
      "name": "<Ada & Lin>",
      "status": "active",
      "joined": "2026-01-02T09:00:00",
      "score": 1234567.5,
