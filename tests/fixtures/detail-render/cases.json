  {
    "name": "format-text-truncate-code-points",
    "note": "truncate counts Unicode code points, keeps the integer part of the limit and applies only a number.",
    "spec": {
      "fields": {
        "emoji": {
          "field": ".emoji",
          "label": "Emoji",
          "format": {
            "type": "text",
            "truncate": 2
          }
        },
        "hangul": {
          "field": ".hangul",
          "label": "Hangul",
          "format": {
            "type": "text",
            "truncate": 3
          }
        },
        "fraction": {
          "field": ".plain",
          "label": "Fraction",
          "format": {
            "type": "text",
            "truncate": 2.9
          }
        },
        "below": {
          "field": ".short",
          "label": "Below",
          "format": {
            "type": "text",
            "truncate": 0.5
          }
        },
        "text": {
          "field": ".plain",
          "label": "Text",
          "format": {
            "type": "text",
            "truncate": "2"
          }
        }
      }
    },
    "record": {
      "emoji": "a😀bc",
      "hangul": "가나다라마",
      "plain": "abcd",
      "short": "abc"
    },
    "options": {
      "language": "en"
    },
    "expected_html": "<dl class=\"detail-view\"><div class=\"detail-field\"><dt class=\"detail-label\">Emoji</dt><dd class=\"detail-value detail-value-text\">a😀…</dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Hangul</dt><dd class=\"detail-value detail-value-text\">가나다…</dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Fraction</dt><dd class=\"detail-value detail-value-text\">ab…</dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Below</dt><dd class=\"detail-value detail-value-text\">abc</dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Text</dt><dd class=\"detail-value detail-value-text\">abcd</dd></div></dl>"
  },
