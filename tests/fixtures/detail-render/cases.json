  },
  {
    "name": "format-bool",
    "note": "bool format as check, icon and text.",
    "spec": {
      "fields": {
        "check": {
          "field": ".admin",
          "label": "Check",
          "format": {
            "type": "bool",
            "as": "check",
            "labels": {
              "true": "Yes",
              "false": "No"
            }
          }
        },
        "icon": {
          "field": ".admin",
          "label": "Icon",
          "format": {
            "type": "bool",
            "as": "icon",
            "labels": {
              "true": "Yes",
              "false": "No"
            }
          }
        },
        "text": {
          "field": ".admin",
          "label": "Text",
          "format": {
            "type": "bool",
            "labels": {
              "true": "Yes",
              "false": "No"
            }
          }
        }
      }
    },
    "record": {
      "id": 7,
      "name": "<Ada & Lin>",
      "status": "active",
      "joined": "2026-01-02T09:00:00",
      "score": 1234567.5,
      "admin": 1,
      "avatar": "/img/ada.png",
      "notes": "<b>bold</b>"
    },
    "options": {
      "language": "en"
    },
    "expected_html": "<dl class=\"detail-view\"><div class=\"detail-field\"><dt class=\"detail-label\">Check</dt><dd class=\"detail-value detail-value-bool\"><span aria-label=\"true\" class=\"bool-check\">✔</span></dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Icon</dt><dd class=\"detail-value detail-value-bool\"><span aria-label=\"true\" class=\"bool-icon bool-true\"></span></dd></div><div class=\"detail-field\"><dt class=\"detail-label\">Text</dt><dd class=\"detail-value detail-value-bool\"><span class=\"bool-text\">true</span></dd></div></dl>"
  },
