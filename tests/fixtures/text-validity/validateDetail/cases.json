[
  {
    "name": "pass-paired-surrogates",
    "note": "a surrogate pair is valid text in a field label.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "label": "A😀"
        }
      }
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "spec-lone-low-in-label",
    "note": "a lone low surrogate in a field label is a load failure.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-032",
      "CUIT-033",
      "CUIT-035",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "label": "\udc00"
        }
      }
    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "fields.name.label"
    }
  },
  {
    "name": "spec-reversed-pair-in-format",
    "note": "a reversed pair in format options is a load failure at its path.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-032",
      "CUIT-033",
      "CUIT-035",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "fields": {
        "state": {
          "field": "state",
          "format": {
            "type": "badge",
            "map": {
              "active": "\udc00\ud800"
            }
          }
        }
      }
    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "fields.state.format.map.active"
    }
  },
  {
