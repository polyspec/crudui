[
  {
    "name": "pass-paired-surrogates",
    "note": "a surrogate pair is valid text in a column label.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "columns": {
        "name": {
          "field": "name",
          "label": "A😀"
        }
      }
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "spec-lone-high-in-label",
    "note": "a lone high surrogate in a column label is a load failure.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "columns": {
        "name": {
          "field": "name",
          "label": "\ud800"
        }
      }
    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "columns.name.label"
    }
  },
  {
    "name": "spec-member-name",
    "note": "an invalid column name is reported at the columns object.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "columns": {
        "\udc00\ud800": {
          "field": "x"
        }
      }
    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "columns"
    }
  },
  {
    "name": "spec-before-forbidden-key",
    "note": "text is checked before the forbidden-key scan.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
      "CUIT-003",
      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "columns": {
        "name": {
          "field": "name",
          "if": 1,
          "label": "\udc00"
        }
      }
    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "columns.name.label"
    }
  },
  {
    "name": "file-document",
    "note": "invalid text in a file is located at the file name and path.",
    "requirements": [
      "CUIT-001",
      "CUIT-002",
