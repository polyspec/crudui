      "CUIT-004",
      "CUIT-009",
      "CUIT-023",
      "CUIT-024",
      "CUIT-025",
      "CUIT-037",
      "CUIT-038",
      "CUIT-039",
      "CUIT-040"
    ],
    "spec": {
      "columns": {
        "name": {
          "field": "name",
          "label": "Name"
        }
      }
    },
