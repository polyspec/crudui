  {
    "name": "data-nested-row",
    "note": "a value in a keyed row is located by its row key.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text"
        },
        "tags": {
          "type": "checkbox",
          "options": {
            "items": [
              "a",
              "b"
            ]
          }
        },
        "rows": {
          "type": "group",
          "multiple": true,
          "properties": {
            "name": {
              "type": "text"
            }
          }
        }
      }
    },
    "data": {
      "rows": {
        "k1": {
          "name": "ok"
        },
        "k2": {
          "name": "\udc00\ud800"
        }
      }
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: data.rows.k2.name",
      "at": ""
    }
  },
  {
    "name": "data-array-item",
    "note": "a list value is located by item index.",
