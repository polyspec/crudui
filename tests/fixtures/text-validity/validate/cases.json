[
  {
    "name": "pass-paired-surrogates",
    "note": "a surrogate pair and a private use character are Unicode scalar values in a label, a member name and a value.",
    "spec": {
      "type": "group",
      "properties": {
        "n😀": {
          "type": "text",
          "label": "A😀"
        }
      }
    },
    "data": {
      "n😀": "x😀"
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "spec-lone-high-in-label",
    "note": "a lone high surrogate in a label is a load failure at the label path.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "A\ud800"
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties.name.label"
    }
  },
  {
    "name": "spec-lone-low-in-member-name",
    "note": "a lone low surrogate in a member name is reported at the object that holds the member.",
    "spec": {
      "type": "group",
      "properties": {
        "n\udc00": {
          "type": "text"
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties"
    }
  },
  {
    "name": "spec-reversed-pair-in-array",
    "note": "a low surrogate followed by a high surrogate is two unpaired code units; array items are located by index.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "validate": {
            "in": [
              "a",
              "b\udc00\ud800"
            ]
          }
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties.name.validate.in.1"
    }
  },
  {
    "name": "spec-member-order",
    "note": "members are checked in code point order of their names, not in document order.",
    "spec": {
      "type": "group",
      "properties": {
        "b": {
          "type": "text",
          "label": "\ud800"
        },
        "a": {
          "type": "text",
          "label": "\udc00"
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties.a.label"
    }
  },
  {
    "name": "spec-code-point-order",
    "note": "U+E000 precedes U+1F600 in code point order although its UTF-16 unit is larger than a surrogate.",
    "spec": {
      "type": "group",
      "properties": {
        "😀": {
          "type": "text",
          "label": "\ud800"
        },
        "": {
          "type": "text",
          "label": "\ud800"
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties..label"
    }
  },
  {
    "name": "spec-root-member-name",
    "note": "an invalid member name of the specification root is located at the empty path.",
    "spec": {
      "type": "group",
      "properties": {},
      "\ud800": 1
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": ""
    }
  },
  {
    "name": "spec-before-data",
