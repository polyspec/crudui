    },
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "properties.name.label"
    }
  },
  {
    "name": "file-name",
    "note": "an invalid file name is located at the empty path.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
    "files": {
      "b\ud800.yml": {
        "properties": {
          "extra": {
            "type": "text",
            "label": "Extra"
          }
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": ""
    }
  },
  {
    "name": "file-document",
    "note": "invalid text in a file is located at the file name followed by its path, whether or not a reference reads the file.",
