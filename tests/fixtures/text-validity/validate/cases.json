        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
    "files": {
      "base.yml": {
        "properties": {
          "extra": {
            "type": "text",
            "label": "\udc00"
          }
        }
      }
    },
    "data": {},
    "expect": {
      "code": "INVALID_TEXT",
      "message": "Text must be Unicode scalar values",
      "at": "base.yml.properties.extra.label"
    }
  },
  {
    "name": "file-order",
    "note": "files are checked in code point order of their names.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
