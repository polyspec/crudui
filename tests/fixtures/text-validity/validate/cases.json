    "data": {
      "tags": [
        "a",
        "\ud800"
      ]
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: data.tags.1",
      "at": ""
    }
  },
  {
