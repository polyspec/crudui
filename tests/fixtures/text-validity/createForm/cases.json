      "at": ""
    }
  },
  {
    "name": "template-member-name",
    "note": "an invalid member name in a template is reported at its object.",
    "template": {
      "kind": "crudui/form-template",
      "fields": [
        {
          "name": "name",
          "spec": {
            "type": "text",
            "label": "Name"
          },
          "children": []
        }
      ],
      "buttons": [
        {
          "type": "submit"
        }
      ],
      "\udc00\ud800": 1
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: template",
      "at": ""
    }
  },
  {
    "name": "set-data",
    "note": "replacing the record checks its text.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text"
        },
        "tags": {
          "type": "checkbox",
          "options": {
            "items": [
              "a",
              "b"
            ]
          }
        },
        "rows": {
          "type": "group",
          "multiple": true,
          "properties": {
            "name": {
              "type": "text"
            }
          }
        }
      }
    },
    "action": {
      "method": "setData",
      "args": [
        {
          "rows": {
            "k1": {
              "name": "\udc00\ud800"
            }
          }
        }
      ]
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: data.rows.k1.name",
      "at": ""
    }
  },
