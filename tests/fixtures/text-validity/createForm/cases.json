[
  {
    "name": "pass-paired-surrogates",
    "note": "a surrogate pair is valid text in data and in a set value.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
    "data": {
      "name": "😀"
    },
    "action": {
      "method": "setValue",
      "args": [
        "name",
        "y😀"
      ]
    },
    "expect": "pass"
  },
  {
    "name": "data-lone-low-value",
    "note": "a lone low surrogate in initial data is an input failure.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
    "data": {
      "name": "\udc00"
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: data.name",
      "at": ""
    }
  },
  {
    "name": "data-before-options",
    "note": "the data is checked before the options.",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text",
          "label": "Name"
        }
      }
    },
    "data": {
      "\ud800": 1
    },
    "options": {
      "keyPrefix": "\ud800"
    },
    "expect": {
      "code": "INVALID_FORM_INPUT",
      "message": "Text must be Unicode scalar values: data",
      "at": ""
    }
  },
  {
    "name": "key-prefix",
