  {
    "name": "toggle-collapses-and-appends",
    "note": "A toggled expanded row is appended to the collapsed rows.",
    "requirements": [
      "CURT-071"
    ],
    "op": "toggleRowView",
    "args": [
      {
        "collapsed": [
          "teams.__0000000000001__.members.__0000000000011__"
        ]
      },
      "teams.__0000000000001__"
    ],
    "expected": {
      "result": {
        "collapsed": [
          "teams.__0000000000001__.members.__0000000000011__",
          "teams.__0000000000001__"
        ]
      }
    }
  },
  {
    "name": "toggle-expands",
    "note": "A toggled collapsed row leaves the others in order.",
    "requirements": [
      "CURT-071"
    ],
    "op": "toggleRowView",
    "args": [
      {
        "collapsed": [
          "teams.__0000000000001__",
          "teams.__0000000000001__.members.__0000000000011__",
          "teams.__0000000000002__"
        ]
      },
      "teams.__0000000000001__.members.__0000000000011__"
    ],
    "expected": {
      "result": {
        "collapsed": [
          "teams.__0000000000001__",
          "teams.__0000000000002__"
        ]
      }
    }
  },
  {
    "name": "collapsible-rows-depth-first",
    "note": "The collapsible rows of the evaluated nodes in node order, depth first.",
    "requirements": [
      "CURT-072"
    ],
    "op": "collapsibleRows",
    "args": [
      {
        "type": "group",
        "properties": {
          "teams": {
            "type": "group",
            "label": "Team",
            "multiple": {
              "min": 1,
              "max": 5,
              "sortable": true,
              "copy": true,
              "title": "name"
            },
            "properties": {
              "name": {
                "type": "text",
                "label": "Name"
              },
              "members": {
                "type": "group",
                "label": "Member",
                "multiple": {
                  "title": "name"
                },
                "properties": {
                  "name": {
                    "type": "text",
                    "label": "Name"
                  }
                }
              }
            }
          },
          "note": {
            "type": "text",
            "label": "Note"
          }
        }
      },
      {
        "teams": {
          "__0000000000001__": {
            "name": "Alpha",
            "members": {
              "__0000000000011__": {
                "name": "One"
              },
              "__0000000000012__": {
                "name": "Two"
              }
            }
          },
          "__0000000000002__": {
            "name": "Beta",
            "members": {
              "__0000000000013__": {
                "name": "Three"
              }
            }
          }
        },
        "note": ""
      }
    ],
    "expected": {
      "result": [
        "teams.__0000000000001__",
        "teams.__0000000000001__.members.__0000000000011__",
        "teams.__0000000000001__.members.__0000000000012__",
        "teams.__0000000000002__",
        "teams.__0000000000002__.members.__0000000000013__"
      ]
    }
  },
  {
