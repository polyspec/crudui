  {
    "name": "remove-row-drops-inner-paths",
    "note": "Removing a row drops its path and the paths inside it, not a path that only starts with the same text.",
    "requirements": [
      "CURT-074"
    ],
    "op": "removeRowView",
    "args": [
      {
        "collapsed": [
          "teams.__0000000000001__",
          "teams.__0000000000001__.members.__0000000000011__",
          "teams.__0000000000001__x",
          "teams.__0000000000002__"
        ]
      },
      "teams.__0000000000001__"
    ],
    "expected": {
      "result": {
        "collapsed": [
          "teams.__0000000000001__x",
          "teams.__0000000000002__"
        ]
      }
    }
