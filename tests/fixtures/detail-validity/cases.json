[
  {
    "name": "ok-basic-detail",
    "note": "the smallest valid detail specification with text and badge fields.",
    "expect": "ok",
    "engine": "pass",
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "label": "Name",
          "format": "text"
        },
        "state": {
          "field": "state",
          "format": {
            "type": "badge",
            "map": {
              "active": "success"
            }
          }
        }
      }
    }
  },
  {
    "name": "red-detail-sortable",
    "note": "sortable is a list column key; the meta-schema rejects it on a detail field, and the four-language engine accepts it because it is not a forbidden key.",
    "expect": "fail",
    "reason": "additionalProperties",
    "engine": "pass",
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "sortable": true
        }
      }
    }
  },
  {
    "name": "ok-compose-ref-patch-fields",
    "note": "$ref and $patch on the fields map use the same composition engine as form properties; files resolve the base for the engine.",
    "expect": "ok",
    "engine": "pass",
    "files": {
      "base-fields.yml": {
        "properties": {
          "name": {
            "field": "name",
            "label": "Name"
          }
        }
      }
    },
    "spec": {
      "fields": {
        "$ref": "base-fields.yml",
        "$patch": {
          "extra": {
            "field": "extra",
            "label": "Extra"
          }
        }
      }
    }
  },
  {
    "name": "root-ref-without-own-fields",
    "note": "a root $ref inherits a base detail specification exposed under a properties layer. The meta-schema reads only spec and requires fields; the four-language engine composes the base and accepts it.",
    "expect": "fail",
    "reason": "required",
    "engine": "pass",
    "files": {
      "base-detail.yml": {
        "properties": {
          "fields": {
            "name": {
              "field": "name"
            }
          }
        }
      }
    },
    "spec": {
      "$ref": "base-detail.yml"
    }
  },
  {
    "name": "red-forbidden-field-key",
    "note": "a forbidden condition meta key used as a field key is a load failure.",
    "expect": "fail",
    "reason": "propertyNames",
    "engine": {
      "code": "FORBIDDEN_META_KEY",
      "at": "fields.display_switch"
    },
    "spec": {
      "fields": {
        "name": {
          "field": "name"
        },
        "display_switch": {
          "field": "x"
        }
      }
    }
  },
  {
    "name": "red-show-if-on-field",
    "note": "show_if on a field is a forbidden meta key.",
    "expect": "fail",
    "reason": "additionalProperties",
    "engine": {
      "code": "FORBIDDEN_META_KEY",
      "at": "fields.name.show_if"
    },
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "show_if": ".admin"
        }
      }
    }
  },
  {
    "name": "red-forbidden-key-in-format-options",
    "note": "a forbidden meta key inside the open format options object is a load failure.",
    "expect": "fail",
    "reason": "propertyNames",
    "engine": {
      "code": "FORBIDDEN_META_KEY",
      "at": "fields.name.format.if"
    },
    "spec": {
      "fields": {
        "name": {
          "field": "name",
          "format": {
            "type": "badge",
            "if": ".admin"
          }
        }
      }
    }
  },
  {
    "name": "patched-field-forbidden-key",
    "note": "a forbidden key introduced by $patch is rejected by the meta-schema inside the patch and by the four-language engine after composition.",
    "expect": "fail",
    "reason": "propertyNames",
    "engine": {
      "code": "FORBIDDEN_META_KEY",
      "at": "fields.extra.when"
    },
    "files": {
      "base-fields.yml": {
        "properties": {
          "name": {
            "field": "name"
          }
        }
      }
    },
    "spec": {
      "fields": {
        "$ref": "base-fields.yml",
        "$patch": {
          "extra": {
            "field": "extra",
            "when": ".admin"
          }
        }
      }
    }
  },
  {
    "name": "red-forbidden-root-key",
    "note": "a forbidden meta key at the detail root is a load failure.",
    "expect": "fail",
    "reason": "additionalProperties",
    "engine": {
      "code": "FORBIDDEN_META_KEY",
      "at": "if"
    },
    "spec": {
      "fields": {
        "name": {
          "field": "name"
        }
      },
      "if": ".admin"
    }
  },
  {
    "name": "red-unresolved-fields-ref",
    "note": "an unresolved $ref on the fields map is a load failure.",
    "expect": "ok",
    "engine": {
      "code": "REF_FILE_NOT_FOUND",
      "at": "missing.yml"
    },
    "spec": {
      "fields": {
        "$ref": "missing.yml"
      }
    }
  }
]
