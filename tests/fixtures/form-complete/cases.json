[
  {
    "name": "complete-form",
    "note": "the form element, a hidden field, a form error and a field error; attribute and text values are escaped.",
    "spec": {
      "type": "group",
      "properties": {
        "email": {
          "type": "text",
          "label": "Email"
        }
      }
    },
    "data": {
      "email": "a@b"
    },
    "options": {
      "language": "en"
    },
    "render": {
      "action": {
        "method": "post",
        "url": "/sign-in"
      },
      "hidden": {
        "_csrf": "t<&>\"'"
      },
      "formErrors": [
        "Sign-in failed."
      ],
      "errors": [
        {
          "path": "email",
          "field": "email",
          "rule": "required",
          "message": "Enter <email> & retry.",
          "value": ""
        }
      ]
    },
    "expected_html": "<form action=\"/sign-in\" method=\"post\"><input type=\"hidden\" name=\"_csrf\" value=\"t&lt;&amp;&gt;&quot;&#x27;\"/><div class=\"crudui-form\"><div class=\"crudui-form__errors\"><p class=\"crudui-form__error\">Sign-in failed.</p></div><div class=\"crudui-form__body\"><div class=\"crudui-node crudui-node--field\" data-field-path=\"email\"><div class=\"crudui-node__header\"><label class=\"crudui-node__label\" for=\"crudui:email\">Email</label></div><div class=\"crudui-node__body\"><div class=\"crudui-widget\"><input type=\"text\" class=\"valid-target crudui-input\" data-name=\"email\" data-rule-name=\"email\" data-default=\"\" id=\"crudui:email\" name=\"email\" value=\"a@b\"/></div></div><div class=\"crudui-node__errors\"><p class=\"crudui-node__error\">Enter &lt;email&gt; &amp; retry.</p></div></div></div><div class=\"crudui-form__footer\"><div class=\"crudui-controls\" role=\"group\" aria-label=\"Form actions\"><button type=\"submit\" class=\"crudui-action crudui-action--text\">Save</button></div></div></div></form>"
  },
  {
    "name": "template-action",
    "note": "each form attribute takes the render member, or the template action member when the render action has none.",
    "spec": {
      "type": "group",
      "properties": {
        "email": {
          "type": "text",
          "label": "Email"
        }
      },
      "action": {
        "method": "post",
        "url": "/save",
        "enctype": "multipart/form-data"
      }
    },
    "data": {
      "email": "a@b"
    },
    "options": {
      "language": "en"
    },
    "render": {
      "action": {
        "url": "/members/42?a=1&b=2"
      }
    },
