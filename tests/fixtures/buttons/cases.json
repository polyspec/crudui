  {
    "name": "button-without-text-fails",
    "note": "A button that declares no text fails at compile time.",
    "requirements": [
      "CURP-008"
    ],
    "operation": "bindButtons",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text"
        }
      },
      "buttons": [
        {
          "type": "button"
        }
      ]
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Invalid buttons.0.text at form: expected content for this button type"
      }
    }
  },
  {
    "name": "template-not-compiled",
    "note": "A value that is not a compiled form template is refused before its buttons are read.",
    "requirements": [
      "CURP-008"
    ],
    "operation": "bindButtons",
    "template": {
      "kind": "other"
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Unsupported form template"
      }
    }
  },
  {
    "name": "template-with-unknown-button-type",
    "note": "A compiled button whose type is no form button type is refused.",
    "requirements": [
      "CURP-008"
    ],
    "operation": "bindButtons",
    "template": {
      "kind": "crudui/form-template",
      "fields": [
        {
          "name": "name",
          "spec": {
            "type": "text"
          },
          "children": []
        }
      ],
      "buttons": [
        {
          "type": "other",
          "text": "x"
        }
      ]
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Invalid button type: other"
      }
    }
  },
  {
