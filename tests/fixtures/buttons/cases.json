  },
  {
    "name": "html-empty-list",
    "note": "No buttons give an empty string.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [],
    "expected": {
      "result": ""
    }
  },
  {
    "name": "html-one-submit",
    "note": "One submit button is a button element with its type first.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "submit",
        "tag": "button",
        "text": "Save",
        "attrs": {
          "type": "submit",
          "class": "crudui-action crudui-action--text"
        }
      }
    ],
    "expected": {
      "result": "<button type=\"submit\" class=\"crudui-action crudui-action--text\">Save</button>"
    }
  },
  {
    "name": "html-link-and-buttons",
    "note": "A link is an a element with the href attribute after the class; the other types are button elements.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "submit",
        "tag": "button",
        "text": "Save",
        "attrs": {
          "type": "submit",
          "class": "crudui-action crudui-action--text"
        }
      },
      {
        "type": "link",
        "tag": "a",
        "text": "List",
        "attrs": {
          "class": "crudui-action crudui-action--text",
          "href": "/items?a=1&b=\"2\""
        }
      },
      {
        "type": "button",
        "tag": "button",
        "text": "Hi <b>&",
        "attrs": {
          "type": "button",
          "class": "crudui-action crudui-action--text wide",
          "style": "color: red",
          "onclick": "go(\"x\")"
        }
      },
      {
        "type": "reset",
        "tag": "button",
        "text": "Reset",
        "attrs": {
          "type": "reset",
          "class": "crudui-action crudui-action--text",
          "name": "r",
          "value": "v"
        }
      }
    ],
    "expected": {
      "result": "<button type=\"submit\" class=\"crudui-action crudui-action--text\">Save</button><a class=\"crudui-action crudui-action--text\" href=\"/items?a=1&amp;b=&quot;2&quot;\">List</a><button type=\"button\" class=\"crudui-action crudui-action--text wide\" style=\"color: red\" onclick=\"go(&quot;x&quot;)\">Hi &lt;b&gt;&amp;</button><button type=\"reset\" class=\"crudui-action crudui-action--text\" name=\"r\" value=\"v\">Reset</button>"
    }
  },
  {
    "name": "html-attributes-in-order",
    "note": "The attributes of a button follow the order type, class, style, name, value, href, onclick.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "button",
        "tag": "button",
        "text": "Hi <b>&",
        "attrs": {
          "type": "button",
          "class": "crudui-action crudui-action--text wide",
          "style": "color: red",
          "onclick": "go(\"x\")"
        }
      },
      {
        "type": "reset",
        "tag": "button",
        "text": "Reset",
        "attrs": {
          "type": "reset",
          "class": "crudui-action crudui-action--text",
          "name": "r",
          "value": "v"
        }
      }
    ],
    "expected": {
      "result": "<button type=\"button\" class=\"crudui-action crudui-action--text wide\" style=\"color: red\" onclick=\"go(&quot;x&quot;)\">Hi &lt;b&gt;&amp;</button><button type=\"reset\" class=\"crudui-action crudui-action--text\" name=\"r\" value=\"v\">Reset</button>"
    }
  },
  {
    "name": "html-escapes-text-and-attributes",
    "note": "The text and the attribute values are escaped, the quotes in an attribute included.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "button",
        "tag": "button",
        "text": "<&>",
        "attrs": {
          "type": "button",
          "class": "crudui-action",
          "onclick": "a\"b"
        }
      }
    ],
    "expected": {
      "result": "<button type=\"button\" class=\"crudui-action\" onclick=\"a&quot;b\">&lt;&amp;&gt;</button>"
    }
  },
  {
    "name": "html-not-a-list",
    "note": "Something other than a list of buttons is refused.",
    "requirements": [
      "CURP-009"
    ],
