  {
    "name": "html-tag-not-element",
    "note": "An element that is neither a link nor a button is refused.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "submit",
        "tag": "div",
        "text": "x",
        "attrs": {
          "type": "submit",
          "class": "crudui-action"
        }
      }
    ],
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Form buttons must be evaluated button objects"
      }
    }
  },
  {
    "name": "html-attribute-not-allowed",
    "note": "An attribute outside the button attributes is refused.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "submit",
        "tag": "button",
        "text": "x",
        "attrs": {
          "type": "submit",
          "class": "crudui-action",
          "onmouseover": "x"
        }
      }
    ],
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Form buttons must be evaluated button objects"
      }
    }
  },
  {
    "name": "html-class-not-a-string",
    "note": "A class that is not a string is refused.",
    "requirements": [
      "CURP-009"
    ],
    "operation": "formButtonsHtml",
    "buttons": [
      {
        "type": "submit",
        "tag": "button",
        "text": "x",
        "attrs": {
          "type": "submit",
          "class": 1
        }
      }
    ],
    "expected": {
      "error": {
        "code": "INVALID_FORM_INPUT",
        "message": "Form buttons must be evaluated button objects"
      }
    }
  }
]
