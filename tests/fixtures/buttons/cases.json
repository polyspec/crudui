[
  {
    "name": "default-submit-only",
    "note": "A spec without buttons has one submit button with the interface text of its type.",
    "requirements": [
      "CURP-008"
    ],
    "operation": "bindButtons",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text"
        }
      }
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "result": [
        {
          "type": "submit",
          "tag": "button",
          "text": "Save",
          "attrs": {
            "type": "submit",
            "class": "crudui-action crudui-action--text"
          }
        }
      ]
    }
  },
  {
    "name": "declared-buttons-en",
    "note": "Declared buttons keep their order, text, design, behavior and link.",
    "requirements": [
      "CURP-008"
    ],
    "operation": "bindButtons",
    "spec": {
      "type": "group",
      "properties": {
        "name": {
          "type": "text"
        }
      },
      "action": {
        "method": "post",
        "url": "/save"
      },
      "buttons": [
        {
          "type": "submit",
          "name": "__submitted__",
          "value": "go",
          "text": {
            "ko": "저장하기",
            "en": "Save now"
          },
          "design": {
            "class": "primary"
          }
        },
        {
          "type": "reset"
        },
        {
          "type": "button",
          "text": "Cancel",
          "behavior": {
            "onclick": "history.back()"
          }
        },
        {
          "type": "link",
          "text": "List",
          "href": "../?a=1&b=\"2\""
        }
      ]
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "result": [
        {
          "type": "submit",
          "tag": "button",
          "text": "Save now",
          "attrs": {
            "type": "submit",
            "class": "crudui-action crudui-action--text primary",
            "name": "__submitted__",
            "value": "go"
          }
        },
        {
          "type": "reset",
          "tag": "button",
          "text": "Reset",
          "attrs": {
            "type": "reset",
            "class": "crudui-action crudui-action--text"
          }
        },
        {
          "type": "button",
          "tag": "button",
          "text": "Cancel",
          "attrs": {
            "type": "button",
            "class": "crudui-action crudui-action--text",
            "onclick": "history.back()"
          }
        },
        {
          "type": "link",
          "tag": "a",
          "text": "List",
          "attrs": {
            "class": "crudui-action crudui-action--text",
            "href": "../?a=1&b=\"2\""
          }
        }
      ]
    }
  },
