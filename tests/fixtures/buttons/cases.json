        }
      },
      "buttons": [
        {
          "type": "link",
          "text": "Open",
          "href": "/a?x=1&y=\"2\""
        }
      ]
    },
    "data": {},
    "options": {
      "language": "en"
    },
    "expected": {
      "result": [
        {
          "type": "link",
          "tag": "a",
          "text": "Open",
          "attrs": {
            "class": "crudui-action crudui-action--text",
            "href": "/a?x=1&y=\"2\""
          }
        }
      ]
    }
