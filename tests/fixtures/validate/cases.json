  {
    "name": "null-content-4lang-no-validate-effect",
    "note": "G3 — label:null plus a 4-language content map with a null slot ({ko,en,ja:null,zh}) have no validate effect; required still fires on an empty value",
    "spec": {
      "type": "group",
      "properties": {
        "nickname": {
          "type": "text",
          "label": null,
          "description": {
            "ko": "별명",
            "en": "Nickname",
            "ja": null,
            "zh": "昵称"
          },
          "validate": {
            "required": true
          }
        }
      }
    },
    "data": {
      "nickname": ""
    },
    "expected": {
      "valid": false,
      "errors": [
        {
          "path": "nickname",
          "field": "nickname",
          "rule": "required",
          "message": "This field is required.",
          "value": ""
        }
      ]
    }
  },
  {
    "name": "keyed-scalar-email-errors",
    "note": "Repeated scalar errors preserve sorted row keys.",
    "spec": {
      "type": "group",
      "properties": {
        "emails": {
          "type": "email",
          "multiple": true,
          "validate": {
            "email": true
          }
        }
      }
    },
    "data": {
      "emails": {
        "__0000000000002__": "invalid-b",
        "__0000000000001__": "invalid-a"
      }
    },
    "expected": {
      "valid": false,
      "errors": [
        {
          "path": "emails.__0000000000001__",
          "field": "__0000000000001__",
          "rule": "email",
          "message": "Please enter a valid email address.",
          "value": "invalid-a"
        },
        {
          "path": "emails.__0000000000002__",
          "field": "__0000000000002__",
          "rule": "email",
          "message": "Please enter a valid email address.",
          "value": "invalid-b"
        }
      ]
    }
  },
  {
