  {
    "name": "compose-ref-patch-email",
    "note": "$ref base (required) + $patch adds email rule; \"bad\" fails email",
    "spec": {
      "$ref": "Base.yml",
      "$patch": {
        "email.validate.email": true
      }
    },
    "files": {
      "Base.yml": {
        "properties": {
          "email": {
            "type": "email",
            "validate": {
              "required": true
            }
          }
        }
      }
    },
    "data": {
      "email": "bad"
    },
    "expected": {
      "valid": false,
      "errors": [
        {
          "path": "email",
          "field": "email",
          "rule": "email",
          "message": "Please enter a valid email address.",
          "value": "bad"
        }
      ]
    }
  },
