{
    "name": "polyspec/crudui-release-install",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "polyspec/crudui-generator": "0.0.9",
        "polyspec/crudui-validator": "0.0.9"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "polyspec/crudui-generator",
                "version": "0.0.9",
                "description": "Form templates, editable data and HTML rendering for CRUDUI",
                "type": "library",
                "license": "MIT",
                "require": {
                    "php": ">=8.4",
                    "php-64bit": "^8.2",
                    "ext-mbstring": "*",
                    "polyspec/crudui-validator": "0.0.9"
                },
                "require-dev": {
                    "phpunit/phpunit": "^13.4.1"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\Crudui\\Generator\\": "src/Internal/",
                        "Polyspec\\Crudui\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Polyspec\\Crudui\\Generator\\Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "test": "COMPOSER_VENDOR_DIR=../../../vendor node ../../../scripts/run-tests.mts phpunit --cwd packages/generator/php -- --testsuite public,php-source-internal"
                },
                "dist": {
                    "type": "zip",
                    "url": "artifacts/polyspec-crudui-generator-php-0.0.9.zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/crudui-validator",
                "version": "0.0.9",
                "description": "PHP validator for crudui system - validates form data against YAML specifications",
                "type": "library",
                "license": "MIT",
                "authors": [
                    {
                        "name": "CRUDUI Team"
                    }
                ],
                "require": {
                    "php": ">=8.4"
                },
                "require-dev": {
                    "phpunit/phpunit": "^13.4.1"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\Crudui\\Validator\\": "src/",
                        "Polyspec\\Crudui\\": "src/Public/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Polyspec\\Crudui\\Validator\\Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "test": "COMPOSER_VENDOR_DIR=../../../vendor node ../../../tests/conformance/run-suite.mts phpunit --cwd packages/validator/php -- --testsuite public,php-source-internal"
                },
                "minimum-stability": "stable",
                "dist": {
                    "type": "zip",
                    "url": "artifacts/polyspec-crudui-validator-php-0.0.9.zip"
                }
            }
        },
        {
            "packagist.org": false
        }
    ]
}
