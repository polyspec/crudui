{
  "name": "@crudui/validator-tests",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-language validation test runner for crudui validators",
  "type": "commonjs",
  "scripts": {
    "test": "node --test runner/compare-all.test.cjs && node runner/compare-all.js",
    "test:js": "node runner/compare-all.js --js-only",
    "test:php": "node runner/compare-all.js --php-only",
    "test:go": "node runner/compare-all.js --go-only",
    "test:rust": "node runner/compare-all.js --rust-only",
    "test:all": "node runner/compare-all.js",
    "test:parity": "npm --prefix parity test",
    "run:js": "ts-node runner/run-js.ts",
    "run:php": "php runner/run-php.php",
    "idempotency": "node runner/compare-all.js",
    "idempotency:js-php": "node runner/compare-all.js --no-go",
    "idempotency:all": "node runner/compare-all.js --verbose"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "form",
    "validation",
    "testing",
    "cross-language"
  ],
  "repository": {
    "type": "git",
    "directory": "tests"
  }
}
