{
  "schema": 1,
  "comment": "The implementations of crudui and the units that each holds.",
  "implementations": [
    {
      "name": "ts",
      "runner": "vitest",
      "prose": [
        "TypeScript",
        "JavaScript"
      ],
      "roots": [
        "packages/generator/ts",
        "packages/validator/ts",
        "packages/html"
      ],
      "internal": [
        {
          "glob": "packages/html/src/button-control.test.ts",
          "reason": "test: the unit test of the HTML renderer's button fields (Button fields); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/choice-appearance.test.ts",
          "reason": "test: the unit test of the HTML renderer's choice appearance (Choice appearance); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/choice-groups.test.ts",
          "reason": "test: the unit test of the HTML renderer's choice groups (Choice groups); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/declared-attributes.test.ts",
          "reason": "test: the unit test of the HTML renderer's declared attributes (Declared attributes); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/inline-layout.test.ts",
          "reason": "test: the unit test of the HTML renderer's layout modifiers (Layout); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/range-control.test.ts",
          "reason": "test: the unit test of the HTML renderer's range fields (Range fields); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/switch-control.test.ts",
          "reason": "test: the unit test of the HTML renderer's switches (Switches); it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/index.test.ts",
          "reason": "test: the unit test of the public renderForm and renderList entry points of the HTML renderer on one instance; it reads no shared suite fixture of tests/fixtures"
        },
        {
          "glob": "packages/html/src/form-session.test.ts",
          "reason": "test: the browser session of the HTML renderer, the browser session of the HTML renderer (the form session of tests/fixtures/form-session); only the TypeScript runtime runs a browser session, and the shared view fixture checks it in the four TypeScript renderers"
        },
        {
          "glob": "packages/html/src/view-session.test.ts",
          "reason": "test: the browser session of the HTML renderer, the browser session of the HTML renderer (the view re-render of tests/fixtures/view-session); only the TypeScript runtime runs a browser session, and the shared view fixture checks it in the four TypeScript renderers"
        }
      ]
    },
    {
      "name": "php",
      "runner": "php",
      "prose": [
        "PHP"
      ],
      "roots": [
        "packages/generator/php",
        "packages/validator/php"
      ]
    },
    {
      "name": "php-extension",
      "runner": "php",
      "prose": [
        "PHP extension"
      ],
      "roots": [
        "packages/php-ext"
      ],
      "tests": [
        "packages/php-ext/tests/engine/*.test.mjs"
      ],
      "internal": [
        {
          "glob": "packages/php-ext/tests/engine/*.test.mjs",
          "reason": "test: the tests of the C engine of the extension, which compile and run C programs of its own parts (text, values, numbers, locale, sanitizers, allocation failure, build); the comparison against the TypeScript reference is in packages/php-ext/tests/comparison"
        }
      ],
      "args": [
        "-d",
        "extension=var/php-ext/polyspec_crudui.so"
      ]
    },
