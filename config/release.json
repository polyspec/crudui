  },
  "consumers": {
    "npm": {
      "directory": "tests/release-install/npm",
      "smoke": {
        "@polyspec/crudui-generator-html": [
          "node",
          "-e",
          "require('@polyspec/crudui-generator-html')"
        ],
        "@polyspec/crudui-generator-core": [
          "node",
          "-e",
          "require('@polyspec/crudui-generator-core')"
        ],
        "@polyspec/crudui-validator": [
          "node",
          "-e",
          "require('@polyspec/crudui-validator')"
        ]
      }
    },
    "composer": {
      "directory": "tests/release-install/composer",
      "smoke": {
        "polyspec/crudui-generator": [
          "php",
          "-r",
          "require 'vendor/autoload.php'; if (!class_exists('Polyspec\\\\Crudui\\\\Generator')) { exit(1); }"
        ],
        "polyspec/crudui-validator": [
          "php",
          "-r",
          "require 'vendor/autoload.php'; if (!class_exists('Polyspec\\\\Crudui\\\\Validator')) { exit(1); }"
        ]
      }
    }
  },
  "proof": {
    "gitTag": {
      "packages/validator-python/pyproject.toml": {
        "kind": "python",
        "name": "polyspec-crudui-validator",
        "smoke": [
          "python",
          "-c",
          "import polyspec.crudui.validator"
        ]
      },
      "packages/generator-python/pyproject.toml": {
        "kind": "python",
        "name": "polyspec-crudui-generator",
        "smoke": [
          "python",
          "-c",
          "import polyspec.crudui.generator"
        ]
      },
      "packages/validator-rust/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-crudui-validator",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/generator-rust/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-crudui-generator",
        "smoke": [
          "cargo",
          "check"
        ]
      }
    }
  }
}
