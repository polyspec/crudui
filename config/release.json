{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/crudui",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "checks": [
    "push-gate",
    "ci-passed"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/form-binding",
      "name": "@polyspec/crudui-form-binding"
    },
    {
      "kind": "npm",
      "directory": "packages/generator/ts",
      "name": "@polyspec/crudui-generator-core"
    },
    {
      "kind": "npm",
      "directory": "packages/html",
      "name": "@polyspec/crudui-generator-html"
    },
    {
      "kind": "npm",
      "directory": "packages/react",
      "name": "@polyspec/crudui-generator-react"
    },
    {
      "kind": "npm",
      "directory": "packages/svelte",
      "name": "@polyspec/crudui-generator-svelte"
    },
    {
      "kind": "npm",
      "directory": "packages/vue",
      "name": "@polyspec/crudui-generator-vue"
    },
    {
      "kind": "npm",
      "directory": "packages/validator/ts",
      "name": "@polyspec/crudui-validator"
    },
    {
      "kind": "composer",
      "directory": "packages/generator/php",
      "name": "polyspec/crudui-generator"
    },
    {
      "kind": "composer",
      "directory": "packages/validator/php",
      "name": "polyspec/crudui-validator"
    },
    {
      "kind": "wheel",
      "directory": "packages/validator/python",
      "name": "polyspec-crudui-validator"
    },
    {
      "kind": "wheel",
      "directory": "packages/generator/python",
      "name": "polyspec-crudui-generator"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/cli/package.json": "version",
    "examples/cross-check-console/server/package.json": "version",
    "packages/form-binding/package.json": "archive",
    "packages/generator/ts/package.json": "archive",
    "packages/html/package.json": "archive",
    "packages/react/package.json": "archive",
    "packages/svelte/package.json": "archive",
    "packages/vue/package.json": "archive",
    "packages/validator/ts/package.json": "archive",
    "packages/generator/php/composer.json": "archive",
    "packages/validator/php/composer.json": "archive",
    "packages/generator/rust/Cargo.toml": "git-tag",
    "packages/validator/rust/Cargo.toml": "git-tag",
    "packages/generator/python/pyproject.toml": "archive",
    "packages/validator/python/pyproject.toml": "archive",
    "examples/cross-check-console/validators/rust/Cargo.toml": "version",
    "examples/form-comparison/servers/rust/Cargo.toml": "version",
    "tests/native-generators/programs/rust/Cargo.toml": "version",
    "benchmarks/validators/rust/Cargo.toml": "version",
    "tests/conformance/python/pyproject.toml": "version"
  },
  "notReleased": {
    "composer.json": "the development root of the Composer packages of packages/, never published; it declares no version",
    "tests/release-install/npm/package.json": "the npm consumer project of the release archives",
    "tests/release-install/composer/composer.json": "the Composer consumer project of the release archives",
    "examples/cross-check-console/validators/go/go.mod": "an example module of this repository, resolved through replace and never tagged",
    "examples/form-comparison/servers/go/go.mod": "an example module of this repository, resolved through replace and never tagged",
    "tests/native-generators/programs/go/go.mod": "a test program module of this repository, resolved through replace and never tagged",
    "scripts/go/go.mod": "the module of the Go table generators of this repository, never tagged",
    "benchmarks/validators/go/go.mod": "a benchmark module of this repository, resolved through replace and never tagged",
    "packages/svelte/tools/package.json": "the tools of packages/svelte that need the TypeScript 6 API, a project of its own outside the npm workspaces",
    "pyproject.toml": "the uv workspace of the Python packages (C14.29), never published; it declares no version"
  },
  "goModules": {
    "packages/generator/go": "github.com/polyspec/crudui/packages/generator/go",
    "packages/validator/go": "github.com/polyspec/crudui/packages/validator/go"
  },
  "consumers": {
    "npm": {
      "directory": "tests/release-install/npm",
      "smoke": {
        "@polyspec/crudui-generator-html": [
          "node",
          "-e",
          "require('@polyspec/crudui-generator-html')"
        ],
        "@polyspec/crudui-generator-core": [
          "node",
          "-e",
          "require('@polyspec/crudui-generator-core')"
        ],
        "@polyspec/crudui-validator": [
          "node",
          "-e",
          "require('@polyspec/crudui-validator')"
        ]
      }
    },
    "composer": {
      "directory": "tests/release-install/composer",
      "smoke": {
        "polyspec/crudui-generator": [
          "php",
          "-r",
          "require 'vendor/autoload.php'; if (!class_exists('Polyspec\\\\Crudui\\\\Generator')) { exit(1); }"
        ],
        "polyspec/crudui-validator": [
          "php",
          "-r",
          "require 'vendor/autoload.php'; if (!class_exists('Polyspec\\\\Crudui\\\\Validator')) { exit(1); }"
        ]
      }
    },
    "wheel": {
      "smoke": {
        "polyspec-crudui-validator": [
          "python",
          "-c",
          "import polyspec.crudui.validator"
        ],
        "polyspec-crudui-generator": [
          "python",
          "-c",
          "import polyspec.crudui.generator"
        ]
      },
      "lock": {
        "polyspec-crudui-validator": "packages/validator/python/pylock.toml",
        "polyspec-crudui-generator": "packages/generator/python/pylock.toml"
      },
      "polyspec": {}
    }
  },
  "proof": {
    "gitTag": {
      "packages/validator/rust/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-crudui-validator",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/generator/rust/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-crudui-generator",
        "smoke": [
          "cargo",
          "check"
        ]
      }
    }
  }
}
