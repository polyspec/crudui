{
  "type": "group",
  "name": "common",
  "action": null,
  "method": "post",
  "buttons": [
    {
      "type": "submit",
      "name": "__submitted__",
      "value": "go",
      "class": "btn-submit",
      "text": "저장"
    },
    {
      "type": "a",
      "href": "../",
      "class": "btn-list float-end",
      "text": "리스트로"
    },
    {
      "type": "button",
      "href": "./",
      "onclick": "if(confirm('작성을 취소하시겠습니까? 페이지를 새로고침합니다.')) {location.reload();}",
      "class": "btn-list float-end me-2",
      "text": "취소"
    }
  ],
  "properties": {
    "common": {
      "label": "기본설정",
      "type": "group",
      "class": "row gx-1",
      "properties": {
        "is_close": {
          "label": "사용여부",
          "type": "choice",
          "default": 0,
          "items": {
            "0": "노출",
            "1": "비노출",
            "9": "삭제",
            "10": "스튜디오",
            "11": "인큐베이터"
          }
        },
        "is_display": {
          "label": "노출 기간",
          "type": "choice",
          "default": 1,
          "class": "col-12 col-sm-6 display-switch-btn",
          "button_class": "w-100",
          "items": {
            "0": "안함",
            "1": "상시",
            "2": "기간설정",
            "3": "시작일만"
          },
          "onchange": "var $this = $(this);\nif(this.value == 0) {\n  $this.closest('.form-group').find('.display-switch').hide();\n  $this.closest('.form-group').find('.display-switch-yoil').hide();\n} else if(this.value == 1) { // 상시 노출\n  $this.closest('.form-group').find('.display-switch').hide();\n  $this.closest('.form-group').find('.display-switch-yoil').hide();\n} else if(this.value == 2) {\n  $this.closest('.form-group').find('.display-switch').show();\n  $this.closest('.form-group').find('.switch-startdt').removeClass('col-sm-12').addClass('col-sm-6').show();\n} else {\n  $this.closest('.form-group').find('.display-switch').hide();\n  $this.closest('.form-group').find('.display-switch-startdt').show();\n  $this.closest('.form-group').find('.switch-startdt').removeClass('col-sm-6').show();\n}\n\n\nif(this.value == 0 || this.value == 1) {\n  //$this.closest('.form-group').find('.module-target').addClass('mt-3').removeClass('mt-0');\n} else {\n  //$this.closest('.form-group').find('.module-target').removeClass('mt-3').addClass('mt-0');\n}\n\nif($this.closest('form').length > 0) {\n  // console.log(this, $this.closest('form'));\n  $this.closest('form').validate().checkByElements(\n    $('.valid-target', $this.closest('.form-element-wrapper').next())\n  );\n}\n"
        },
        "display": {
          "type": "group",
          "class": "col-12 xmt-3 display-switch display-switch-dt display-switch-startdt switch-display copy-hide",
          "group_class": "form-row row g-1  p-0 border-0 bg-transparent",
          "display_target": ".is_display",
          "display_target_condition_class": {
            "0": "last-child",
            "1": "last-child"
          },
          "display_target_condition_style": {
            "0": "display: none",
            "1": "display: none",
            "2": "display: block",
            "3": "1display: block"
          },
          "properties": {
            "start_dt": {
              "label": "시작일",
              "type": "datetime",
              "rules": {
                "required": "..is_display == 2 || ..is_display == 3"
              },
              "class": "col-12 col-sm-6 border-top border-top-1 xpb-0 border-sm-0 display-switch display-switch-dt display-switch-startdt switch-startdt",
              "display_target": "..is_display",
              "display_target_condition_style": {
                "0": "display: none",
                "1": "display: none",
                "2": "display: block",
                "3": "display: block"
              },
              "display_target_condition_class": {
                "0": "col-12 col-sm-6",
                "1": "col-12 col-sm-6",
                "2": "col-12 col-sm-6",
                "3": "col-sm-12"
              },
              "event": {
                "type": [
                  "onchange",
                  "onload"
                ],
                "function": "if(this.value) {\n    if(new Date() > new Date(this.value)) {\n        $(this).addClass('bg-striped border-primary rounded rounded-3');\n    } else {\n        $(this).removeClass('bg-striped border-primary rounded rounded-3');\n    }\n} else {\n    $(this).removeClass('bg-striped border-primary rounded rounded-3');\n}\n"
              }
            },
            "end_dt": {
              "label": "종료일",
              "type": "datetime",
              "class": "col-12 col-sm-6 pt-sm-0 xpb-sm-0 mt-sm-0 border-sm-0 display-switch display-switch-dt switch-enddt mb-1",
              "rules": {
                "required": "..is_display == 2"
              },
              "display_target": "..is_display",
              "display_target_condition_style": {
                "0": "display: none",
                "1": "display: block",
                "3": "display: none"
              },
              "display_target_condition_class": null,
              "event": {
                "function": "if(this.value) {\n    if(new Date() > new Date(this.value)) {\n        $(this).addClass('bg-striped border-danger rounded rounded-3');\n    } else {\n        $(this).removeClass('bg-striped border-danger rounded rounded-3');\n    }\n} else {\n    $(this).removeClass('bg-striped border-danger rounded rounded-3');\n}\n",
                "type": [
                  "onchange",
                  "onload"
                ]
              }
            }
          }
        },
        "yoil": {
          "type": "group",
          "class": "col-12 display-switch display-switch-dt display-switch-startdt switch-yoil display-switch-yoil",
          "group_class": "form-row g-1 p-0 bg-transparent border-0",
          "display_target": ".is_display",
          "display_target_condition_style": {
            "0": "display: none",
            "1": "display: none"
          },
          "properties": {
            "is_allday": {
              "type": "choice",
              "default": 0,
              "class": "col-12 col-sm-3 pb-0 display-switch display-switch-always display-switch-dt display-switch-startdt display-switch-yoil",
              "button_class": "w-100",
              "items": {
                "0": "요일전체",
                "1": "요일별"
              },
              "onchange": "var $this = $(this);\nif(this.value == 0) {\n    $this.closest('.form-element-wrapper').next().hide();\n} else {\n    $this.closest('.form-element-wrapper').next().show();\n}\nif($this.closest('form').length > 0) {\n    $this.closest('form').validate().checkByElements(\n        $('.valid-target', $this.closest('.form-element-wrapper').next())\n    );\n}\n",
              "display_target": ".is_allday",
              "display_target_condition_class": {
                "0": "",
                "1": ""
              }
            },
            "day[]": {
              "type": "multichoice",
              "class": "col-12 col-sm-9 pt-sm-0 pm-sm-0 mt-sm-0 border-0 mb-1x",
              "s": "display-switch display-switch-always display-switch-dt display-switch-startdt display-switch-yoil",
              "element_class": "yoil_elemenet px-2 px-3",
              "items": {
                "is_sunday": "일",
                "is_monday": "월",
                "is_tuesday": "화",
                "is_wednesday": "수",
                "is_thursday": "목",
                "is_friday": "금",
                "is_saturday": "토"
              },
              "button_class": "w-100",
              "rules": {
                "required": "..is_allday == 1"
              },
              "display_target": ".is_allday",
              "display_target_condition_style": {
                "0": "display: none; ",
                "1": "display: block;"
              }
            }
          }
        },
        "is_sale": {
          "label": "판매 구분",
          "description": "판매 안함으로 설정하시면 판매가 중지됩니다.\n",
          "type": "choice",
          "default": 1,
          "items": {
            "0": "판매 안함",
            "1": "상시 판매",
            "2": "기간 판매"
          },
          "onchange": "if(this.value == 2) {\n$(this).closest('.form-element-wrapper').next().show();\n} else {\n$(this).closest('.form-element-wrapper').next().hide();\n}\n"
        },
        "sale": {
          "label": "판매기간",
          "type": "group",
          "display_target": "common.is_sale",
          "display_target_condition_style": {
            "0": "display: none;",
            "1": "display: none;",
            "2": "display: block;"
          },
          "group_class": "form-row row gx-1",
          "properties": {
            "start_dt": {
              "label": "시작일",
              "type": "datetime",
              "rules": {
                "required": "common.is_sale == 2"
              },
              "class": "col-12 col-md-6 pb-md-0"
            },
            "end_dt": {
              "label": "종료일",
              "type": "datetime",
              "rules": {
                "required": "common.is_sale == 2",
                "enddate": "common.sale.start_dt"
              },
              "class": "col-12 col-md-6 border-md-0 pt-md-0 pb-md-0"
            }
          }
        },
        "name": {
          "prepend": "상품 명",
          "type": "text",
          "lang": "append",
          "remove_lang_title": true,
          "rules": {
            "minlength": 1,
            "maxlength": 45,
            "required": true
          },
          "messages": {
            "ko": {
              "maxlength": "{0}자로 입력"
            }
          }
        },
        "id": {
          "label": {
            "ko": "상품 아이디"
          },
          "description": "상품의 고유 코드를 입력하세요.",
          "type": "text",
          "rules": {
            "minlength": 2,
            "maxlength": 45,
            "match": "[0-9a-zA-Z_\\-]{1,44}"
          },
          "messages": {
            "ko": {
              "maxlength": "{0}자로 입력"
            }
          }
        },
        "require_point_start": {
          "label": "필요 포인트 시작",
          "description": "상품을 구매하기 위해 필요한 시작 포인트를 입력하세요.\n",
          "type": "number",
          "default": 0,
          "rules": {
            "required": true,
            "min": 0,
            "max": 100000000
          },
          "messages": {
            "min": "0이상의 숫자를 입력하세요.",
            "max": "100000000이하의 숫자를 입력하세요."
          }
        },
        "require_point_end": {
          "label": "필요 포인트 종료",
          "description": "상품을 구매하기 위해 필요한 종료 포인트를 입력하세요.\n",
          "type": "number",
          "default": 0,
          "rules": {
            "required": true,
            "min": 0,
            "max": 100000000
          },
          "messages": {
            "min": "0이상의 숫자를 입력하세요.",
            "max": "100000000이하의 숫자를 입력하세요."
          }
        },
        "max_quantity": {
          "label": "주문 가능 수량",
          "type": "number",
          "default": 1
        },
        "grade_number": {
          "label": "속성 등급",
          "description": "상품의 속성 등급을 입력하세요.\n1부터 10까지, 높은 숫자일수록 높은 등급입니다.\n",
          "type": "number",
          "rules": {
            "required": true,
            "min": 1,
            "max": 10
          },
          "messages": {
            "min": "1이상의 숫자를 입력하세요.",
            "max": "10이하의 숫자를 입력하세요."
          }
        },
        "product_brand_seq": {
          "label": "브랜드",
          "short_description": "키워드를 입력하여 브랜드를 검색하세요.\n",
          "type": "search",
          "items": [],
          "api_server": "function() {\n  return '../search_product_brand';\n}\n"
        },
        "product_type_attribute_seq": {
          "label": "상품 분류",
          "type": "select",
          "items": {
            "": "선택하세요"
          },
          "rules": {
            "required": true
          },
          "description": "상품 타입을 선택하세요.",
          "onchange": "$(form).ajaxSubmit({\n    type: 'POST',\n    url: '../attribute',\n    dataType: 'json',\n    success: function(result ) {\n        try {\n\n          if('object' == typeof result.payload.spec) {\n            var $form  = $(form);\n\n\n            var spec = $form.validate().getSpec();\n            spec.properties.common.properties.product_type_attribute_items.properties = result.payload.spec.properties.common.properties.product_type_attribute_items.properties;\n            console.log(spec);\n\n            $form.validate().setSpec(spec);\n\n            var result_html = $(result.payload.html).find('[name=\\'common-product_type_attribute_items-layer\\']');\n\n            $('[name=\\'common-product_type_attribute_items-layer\\']').html(result_html.html());\n\n            console.log($('.valid-target-attribute-set'));\n            $form.validate().checkByElements(\n              $('.valid-target-attribute-set')\n            );\n\n          }\n\n        } catch(error) {\n          console.log(error);\n        }\n    },\n    error: function(xhr, status, error) {\n        //alert(xhr.responseJSON.message);\n        console.log('error', xhr, status, error);\n    }\n});\n"
        },
        "product_type_attribute_items": {
          "type": "group",
          "label": "필수 표기 정보",
          "class": "product_type_attribute_items",
          "description": "상품 분류를 먼저 선택하세요.\n"
        },
        "product_attribute": {
          "type": "textarea",
          "rules": {
            "required": true
          },
          "label": "필수 표기 정보"
        },
        "category_seqs[]": {
          "label": "카테고리",
          "type": "select",
          "sortable": true,
          "sortable_button": true,
          "items": {
            "": "선택하세요"
          },
          "multiple": true,
          "rules": {
            "unique": true
          }
        },
        "sub_category_seqs[]": {
          "label": "그루핑",
          "description": "상점내에서 상품을 구루핑합니다.\n'<a href=\"../../store\">정보 설정</a>' >  '추가 설정' > '상품 그룹'에서 설정할수 있습니다.\n",
          "type": "select",
          "sortable": true,
          "sortable_button": true,
          "items": {
            "": "선택하세요"
          },
          "multiple": true,
          "rules": {
            "unique": true,
            "required": true
          }
        },
        "cover_images[]": {
          "label": "상품 이미지",
          "prepend": "첨부",
          "type": "image",
          "multiple": true,
          "sortable": true,
          "rules": {
            "required": true,
            "accept": "image/*"
          },
          "preview-max-width": 200
        },
        "product_attribute_image": {
          "type": "image",
          "prepend": "첨부",
          "rules": {
            "accept": "image/*"
          },
          "label": "필수 표기 정보",
          "preview-max-width": 200
        },
        "short_description": {
          "label": "짧은 설명",
          "description": "리스트 등 짧은 설명이 필요한곳에 사용됩니다.",
          "type": "text"
        },
        "content": {
          "label": "설명",
          "type": "tinymce",
          "fileserver": "../upload",
          "rows": 5,
          "rules": null,
          "lang": "append"
        },
        "is_quantity": {
          "label": "수량 추적",
          "description": "\"사용함\"의 경우 수량을 추적하고 0일경우 판매가 중단됩니다.\n\"사용안함\"의 경우 수량을 입력하지 않아도 되고 추적하지 않으며 0이어도 판매됩니다. 판매여부를 X로 할 경우에만 판매가 중단됩니다.\n\"일별 사용함\"의 경우 일별로 수량을 추적합니다.\n\"전체수량\" 없이 \"판매가능수량\"만 입력해도 됩니다.\n",
          "type": "choice",
          "default": 0,
          "items": {
            "0": "사용안함",
            "1": "사용함",
            "2": "일별 사용함"
          },
          "onchange": "console.log(this.checked);\nif(this.value == 1 || this.value == 2) {\n  $('.items-quantity').show();\n  $('.single-wide4').removeClass('col-md-4');\n  $('.single-wide6').removeClass('col-md-6').addClass('col-md-4');\n\n  $('.msingle-wide4').removeClass('col-md-4').addClass('col-md-2');\n  $('.wide-last-child').removeClass('last-child');\n} else {\n  $('.items-quantity').hide();\n  $('.single-wide4').addClass('col-md-4');\n  $('.single-wide6').removeClass('col-md-4').addClass('col-md-6');\n  $('.msingle-wide4').removeClass('col-md-2').addClass('col-md-4');\n  $('.wide-last-child').addClass('last-child');\n}\n"
        },
        "is_option": {
          "label": "옵션",
          "type": "choice",
          "default": 0,
          "items": {
            "0": "없음",
            "1": "다중",
            "2": "단일"
          },
          "onchange": "console.log(this.value);\nif(this.value == 1) {\n    $('.multiplexable').show();\n\n    $('.single-option-list').hide();\n\n    $('.multiple-option-list').hide();\n\n} else if(this.value == 2) {\n    $('.multiple-option-list').show();\n\n    $('.single-option-list').hide();\n\n    $('.multiplexable').hide();\n\n} else {\n\n    $('.multiple-option-list').hide();\n\n    $('.multiplexable').hide();\n\n    $('.single-option-list').show();\n}\n"
        }
      }
    },
    "option": {
      "type": "group",
      "class": "border-0 pt-0 row gx-1 multiplexable multiplexable-condition",
      "label": "옵션 설정",
      "display_target": "common.is_option",
      "display_target_condition_style": {
        "0": "display: none;",
        "1": "display: block;",
        "2": "display: none;"
      },
      "properties": {
        "groups[]": {
          "type": "group",
          "group_class": "form-row row gx-1",
          "label": "옵션 그룹 설정",
          "description": "옵션명에는 사이즈, 컬러, 타입등을 입력하시고 옵션값에는 각 옵션명에 맞는 값을 입력하세요.\n사이즈의 경우 라지, 미듐, 스몰, 컬러의 경우 블랙, 블루, 그린.., 타입의 경우 A, B, C.. 등을 입력하시고\n조합하시면 사이즈, 컬러, 타입등이 조합된 옵션을 생성해줍니다.\n",
          "multiple": true,
          "sortable": true,
          "dynamic_onchange": "$('[name=option\\\\[button\\\\]]').val('').trigger('change');\n",
          "properties": {
            "name": {
              "label": "옵션명",
              "type": "text",
              "class": "col-12 col-sm-3 py-sm-0",
              "element_class": "option-multiplexable-name",
              "rules": {
                "required": "common.is_option == 1"
              }
            },
            "items[]": {
              "label": "옵션값",
              "multiple": true,
              "sortable": true,
              "dynamic_onchange": "$('[name=option\\\\[button\\\\]]').val('').trigger('change');\n",
              "type": "text",
              "class": "col-12 col-sm-9 col-sm-line-first border-sm-0",
              "element_class": "option-multiplexable-value",
              "rules": {
                "required": "common.is_option == 1",
                "unique": true
              }
            }
          }
        },
        "button": {
          "type": "button",
          "text": "조합",
          "rules": {
            "required": "common.is_option == 1"
          },
          "messages": {
            "required": "옵션 수정이 끝나면 \"조합\" 버튼을 누르고 \"판매 정보\"을 하세요.\n"
          },
          "button_class": "btn-submit",
          "init_script": "$(document).on('change', '[name^=option\\\\[groups\\\\]]', function() {\n  $('[name=option\\\\[button\\\\]]').val('').trigger('change');\n});\n",
          "onclick": "$(form).ajaxSubmit({\n    type: 'POST',\n    url: '../option',\n    dataType: 'json',\n    beforeSubmit: function (data, $form, groups) {\n        var option_chk = true;\n        var option_group_count = $('.option-multiplexable-name').length;\n\n        $('.option-multiplexable-name').each(function() {\n          var items = $(this).closest('.form-group').find('.option-multiplexable-value');\n          console.log(this, items);\n          if(items.length == 1) {\n            option_chk = false;\n          }\n        });\n        console.log(\n          option_group_count, option_chk\n        )\n        if(option_group_count == 1 && option_chk == false) {\n          alert('다중옵션은 옵션을 조합하여 편리하게 입력할수 있습니다.\\n\\n옵션값이 하나일 경우 기본설정 > 옵션 > 단일을 선택하세요.');\n          $('[name=option\\\\[button\\\\]]').val('').trigger('change');\n          return false;\n        }\n        // var data = $form.elementObject();\n        // var formData = new FormData(form[0]);\n\n        var validate = $form.validate();\n        var spec = $form.validate().getSpec();\n\n        var custom_spec = {\n            type: 'group',\n            properties: {\n                common: {\n                    type: 'group',\n                    properties: {\n                        is_option: spec.properties.common.properties.is_option\n                    }\n                },\n                option: {\n                    type: 'group',\n                    properties: {\n                        'groups[]': spec.properties.option.properties['groups[]']\n                    }\n                }\n            }\n        }\n\n        $form.validate().setSpec(custom_spec);\n        var result = validate.loadvalid(true);\n        $form.validate().setSpec(spec);\n\n        return result;\n    },\n    success: function(result ) {\n        console.log(\"result.payload\", result.payload);\n        var $form  = $(form);\n        var result_html = $(result.payload.html).find('[name=\\\"option_multiplexable.items-layer\\\"]');;\n\n        var spec = $form.validate().getSpec();\n        spec.properties.option_multiplexable.properties['items[]'] = result.payload.spec.properties.option_multiplexable.properties['items[]'];\n\n        $form.validate().setSpec(spec);\n\n        try {\n            $('[name=\\\"option_multiplexable.items-layer\\\"]').html(result_html.html());\n        } catch(error) {\n\n        }\n        $('[name=option\\\\[button\\\\]]').val(1).trigger('change');\n\n        //$form.validate().loadvalid();\n\n         $('[name=\\\"option_multiplexable.items-layer\\\"]').scrollView();\n    },\n    error: function(xhr, status, error) {\n        //alert(xhr.responseJSON.message);\n        console.log('error', xhr, status, error);\n    }\n});\n"
        }
      }
    },
