# Toolchain only. The repository is mounted read-only at /workspace/source when the container
# runs; no build step here reads or copies it, so the image changes only with this file.
FROM golang:1.27.0-trixie@sha256:df98008ecd2b0ecc9f0a94d1b07e3564a9c92b555369b33d9b5f60d0765b2db7 AS go
FROM rust:1.98.1-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS rust
# The components that rust-toolchain.toml names; rustup installs nothing on a later cargo.
RUN rustup component add rustfmt clippy

FROM node:26.8.1-trixie-slim@sha256:c0753125a3789977aefe869cbebccf70e3cfd7ea84ca48547458f02e4f1d7146
# Debian packages from the snapshot of one date, so the same definition installs the same packages on every date.
RUN sed -i -e 's#http://deb.debian.org/debian-security#http://snapshot.debian.org/archive/debian-security/20261005T000000Z#' \
      -e 's#http://deb.debian.org/debian#http://snapshot.debian.org/archive/debian/20261005T000000Z#' \
      /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/10snapshot
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git unzip build-essential tini \
    php8.4-cli php8.4-dev php8.4-mbstring php8.4-xml php8.4-fpm nginx composer \
    chromium=154.0.8037.92-1~deb13u1 chromium-sandbox=154.0.8037.92-1~deb13u1 \
    && rm -rf /var/lib/apt/lists/*
# The npm release that packageManager of package.json records (tests/build/runtime-version-policy.test.mjs).
RUN npm install -g npm@12.2.0
COPY --from=go /usr/local/go /usr/local/go
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo/bin /usr/local/cargo/bin
ENV PATH=/usr/local/cargo/bin:/usr/local/go/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/workspace/cache/cargo \
    CARGO_TARGET_DIR=/workspace/build/cargo-target \
    GOPATH=/workspace/cache/go \
    GOCACHE=/workspace/cache/go-build \
    GOTOOLCHAIN=local \
    RUSTUP_AUTO_INSTALL=0 \
    npm_config_cache=/workspace/cache/npm \
    COMPOSER_HOME=/workspace/cache/composer \
    COMPOSER_ROOT_VERSION=0.0.1 \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    FORM_COMPARISON_RESULTS=/results
# The PHP server program starts `php-fpm` and `nginx` by name.
RUN ln -s /usr/sbin/php-fpm8.4 /usr/local/sbin/php-fpm
# The mounted repository belongs to the host user.
RUN git config --system --add safe.directory /workspace/source \
    && mkdir -p /workspace/source /workspace/build /workspace/cache /data /results \
    && chown node:node /workspace/build /workspace/cache /data /results
WORKDIR /workspace
EXPOSE 8080
# New named volumes belong to root. The start command gives the two volume roots to the
# unprivileged user and runs the supervisor as that user. tini is process 1 and reaps the
# orphans of builds, Git comparisons and browser checks, which the supervisor never adopted.
CMD ["/usr/bin/tini", "--", "sh", "-c", "chown node:node /workspace/build /workspace/cache && exec setpriv --reuid=node --regid=node --init-groups env HOME=/home/node node /workspace/source/examples/form-comparison/supervisor.mjs"]
