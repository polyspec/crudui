# Toolchain only. The repository is mounted read-only at /workspace/source when the container
# runs; no build step here reads or copies it, so the image changes only with this file.
FROM golang:1.27-trixie AS go
FROM rust:1-slim-trixie AS rust

FROM node:26-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git unzip build-essential tini \
    php8.4-cli php8.4-dev php8.4-mbstring php8.4-xml php8.4-fpm nginx composer \
    chromium=153.0.8010.47-2~deb13u1 chromium-sandbox=153.0.8010.47-2~deb13u1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo/bin /usr/local/cargo/bin
ENV PATH=/usr/local/cargo/bin:/usr/local/go/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/workspace/cache/cargo \
    CARGO_TARGET_DIR=/workspace/build/cargo-target \
    GOPATH=/workspace/cache/go \
    GOCACHE=/workspace/cache/go-build \
    GOTOOLCHAIN=local \
    npm_config_cache=/workspace/cache/npm \
    COMPOSER_HOME=/workspace/cache/composer \
    COMPOSER_ROOT_VERSION=0.0.1 \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    FORM_COMPARISON_RESULTS=/results
# The PHP server program starts `php-fpm` and `nginx` by name.
RUN ln -s /usr/sbin/php-fpm8.4 /usr/local/sbin/php-fpm
# The mounted repository belongs to the host user.
RUN git config --system --add safe.directory /workspace/source \
    && mkdir -p /workspace/source /workspace/build /workspace/cache /data /results \
    && chown node:node /workspace/build /workspace/cache /data /results
WORKDIR /workspace
EXPOSE 8080
# New named volumes belong to root. The start command gives the two volume roots to the
# application user and runs the supervisor as that user. tini is process 1 and reaps the
# orphans of builds, Git comparisons and browser checks, which the supervisor never adopted.
CMD ["/usr/bin/tini", "--", "sh", "-c", "chown node:node /workspace/build /workspace/cache && exec setpriv --reuid=node --regid=node --init-groups env HOME=/home/node node /workspace/source/examples/form-comparison/supervisor.mjs"]
