{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["adapters/**/*", "pages/**/*", "*.d.ts"]
}
