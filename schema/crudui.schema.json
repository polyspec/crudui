{
  "$id": "https://github.com/polyspec/crudui/schema/crudui.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRUDUI declaration schema",
  "description": "Validates form and list declarations, including field structure, validation, appearance, behavior and composition.",
  "$comment": "Form declarations use the root entry. List declarations use definitions/List. Resolve external references before runtime rendering.",
  "$ref": "#/definitions/Field",
  "definitions": {
    "ForbiddenKeyNames": {
      "$comment": "Restrictions on reserved declaration property names. Reused by field maps and settings objects.",
      "allOf": [
        {
          "not": {
            "enum": [
              "display_switch",
              "display_target",
              "if",
              "when",
              "show_if",
              "_",
              "seqtokey",
              "__13hex__",
              "$after",
              "$before",
              "$merge",
              "$remove",
              "xclass",
              "xstyle"
            ]
          }
        },
        {
          "not": {
            "pattern": "^x[\\s\\S]"
          }
        }
      ]
    },
    "OpenValue": {
      "description": "Value the schema leaves open. Any JSON value is accepted; every object key at every depth must satisfy the property-name rules.",
      "type": [
        "string",
        "number",
        "boolean",
        "null",
        "array",
        "object"
      ],
      "items": {
        "$ref": "#/definitions/OpenValue"
      },
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "additionalProperties": {
        "$ref": "#/definitions/OpenValue"
      }
    },
    "Expression": {
      "description": "Expression string supporting relative paths, comparisons, logic, membership and conditional values. Behavior scripts are separate.",
      "type": "string"
    },
    "ConditionMap": {
      "description": "Evaluates conditions in declaration order and selects the first matching value. The true key supplies the default.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "additionalProperties": {
        "$ref": "#/definitions/OpenValue"
      }
    },
    "LangMap": {
      "description": "Content translations indexed by language code. A null translation represents absent content.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      }
    },
    "Content": {
      "description": "Content text or a language map. Null represents absent content.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/LangMap"
        },
        {
          "type": "null"
        }
      ]
    },
    "ItemLabel": {
      "description": "Choice display label, optionally translated. The choice value is separate from its label.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/LangMap"
        },
        {
          "type": "null"
        }
      ]
    },
    "Validate": {
      "description": "Validation rules in declaration order. Registered rules have typed parameters; other rule names stay open for rules registered by the application.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/ForbiddenKeyNames"
          },
          "properties": {
            "required": {
              "description": "Requires a supplied, nonempty value when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "email": {
              "description": "Requires a syntactically valid email address when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "url": {
              "description": "Requires a valid URL when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "minlength": {
              "description": "Minimum string length in Unicode code points.",
              "$ref": "#/definitions/RuleNumber"
            },
            "maxlength": {
              "description": "Maximum string length in Unicode code points.",
              "$ref": "#/definitions/RuleNumber"
            },
            "rangelength": {
              "description": "Minimum and maximum string length.",
              "$ref": "#/definitions/RuleBounds"
            },
            "number": {
              "description": "Requires a finite number when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "digits": {
              "description": "Requires digits only when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "min": {
              "description": "Numeric lower bound.",
              "$ref": "#/definitions/RuleNumber"
            },
            "max": {
              "description": "Numeric upper bound.",
              "$ref": "#/definitions/RuleNumber"
            },
            "range": {
              "description": "Numeric lower and upper bounds.",
              "$ref": "#/definitions/RuleBounds"
            },
            "step": {
              "description": "Numeric increment.",
              "$ref": "#/definitions/RuleNumber"
            },
            "match": {
              "description": "Regular expression the value must match. Not implicitly anchored.",
              "$ref": "#/definitions/RulePattern"
            },
            "pattern": {
              "description": "Same rule as match under the name used in messages.",
              "$ref": "#/definitions/RulePattern"
            },
            "equalTo": {
              "description": "Field whose value must be equal.",
              "$ref": "#/definitions/RuleFieldReference"
            },
            "notEqual": {
              "description": "Field reference starting with a dot, or a literal value the input must differ from. Passed unchanged.",
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "description": "Disables the rule.",
                  "enum": [
                    false,
                    null
                  ]
                }
              ]
            },
            "in": {
              "description": "Allowed values: a comma-separated string, a list, or a value-to-label map whose keys are the values. Passed unchanged; a map is not a condition map.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/definitions/ForbiddenKeyNames"
                  },
                  "additionalProperties": {
                    "$ref": "#/definitions/ItemLabel"
                  }
                },
                {
                  "description": "Disables the rule.",
                  "enum": [
                    false,
                    null
                  ]
                }
              ]
            },
            "date": {
              "description": "Requires a valid date when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "dateISO": {
              "description": "Requires a YYYY-MM-DD date when enabled.",
              "$ref": "#/definitions/RuleSwitch"
            },
            "enddate": {
              "description": "Start-date field; the end date must not precede it.",
              "$ref": "#/definitions/RuleFieldReference"
            },
            "mincount": {
              "description": "Minimum collection size.",
              "$ref": "#/definitions/RuleNumber"
            },
            "maxcount": {
              "description": "Maximum collection size.",
              "$ref": "#/definitions/RuleNumber"
            },
            "unique": {
              "description": "Uniqueness when enabled; a string names an item field or a filter condition. Passed unchanged.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "description": "Disables the rule.",
                  "enum": [
                    false,
                    null
                  ]
                }
              ]
            },
            "accept": {
              "description": "Accepted file extensions or MIME types, as a comma-separated string or a list. Passed unchanged.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "description": "Disables the rule.",
                  "enum": [
                    false,
                    null
                  ]
                }
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/OpenValue"
          }
        }
      ]
    },
    "DesignNode": {
      "description": "CSS classes and inline styles for a named DOM node.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "description": "CSS classes, optionally selected by an expression or condition map.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/ConditionMap"
            }
          ]
        },
        "style": {
          "description": "Inline styles, optionally selected by an expression or condition map.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/ConditionMap"
            }
          ]
        }
      }
    },
    "Design": {
      "description": "Visibility and appearance settings for the main node and named label, wrapper, group and prepend nodes.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "description": "Visibility expression or condition map.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Expression"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/ConditionMap"
                }
              ]
            },
            "class": {
              "description": "CSS classes, optionally selected by an expression or condition map.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/definitions/ConditionMap"
                }
              ]
            },
            "style": {
              "description": "Inline styles, optionally selected by an expression or condition map.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/definitions/ConditionMap"
                }
              ]
            },
            "label": {
              "description": "Appearance settings for the label node.",
              "$ref": "#/definitions/DesignNode"
            },
            "wrapper": {
              "description": "Appearance settings for the wrapper node.",
              "$ref": "#/definitions/DesignNode"
            },
            "group": {
              "description": "Appearance settings for the group node.",
              "$ref": "#/definitions/DesignNode"
            },
            "prepend": {
              "description": "Appearance settings for the prepend node.",
              "$ref": "#/definitions/DesignNode"
            }
          }
        }
      ]
    },
    "BehaviorAction": {
      "description": "Opaque script string or an object containing a label and script. The expression engine does not execute scripts.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "$ref": "#/definitions/Content"
            },
            "script": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Behavior": {
      "description": "Named client behavior scripts preserved independently of expression evaluation.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "onchange": {
              "$ref": "#/definitions/BehaviorAction"
            },
            "onclick": {
              "$ref": "#/definitions/BehaviorAction"
            },
            "onload": {
              "$ref": "#/definitions/BehaviorAction"
            }
          }
        }
      ]
    },
    "FormAction": {
      "description": "Submission target of the form, kept for the application. Honored on the form root only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "description": "HTTP method.",
          "type": "string"
        },
        "url": {
          "description": "Submission URL.",
          "type": "string"
        },
        "enctype": {
          "description": "Submission encoding.",
          "type": "string"
        }
      }
    },
    "FormButton": {
      "description": "One form button rendered in the form footer. A button or link needs text; a link needs href.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Button type. A link renders an anchor.",
          "enum": [
            "submit",
            "reset",
            "button",
            "link"
          ]
        },
        "text": {
          "description": "Button text, optionally translated. Submit and reset default to interface text.",
          "$ref": "#/definitions/Content"
        },
        "name": {
          "description": "Submitted name.",
          "type": "string"
        },
        "value": {
          "description": "Submitted value.",
          "type": "string"
        },
        "href": {
          "description": "Link target.",
          "type": "string"
        },
        "design": {
          "description": "Button appearance.",
          "$ref": "#/definitions/Design"
        },
        "behavior": {
          "description": "Opaque behavior scripts.",
          "$ref": "#/definitions/Behavior"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "button",
                  "link"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            }
          },
          "then": {
            "required": [
              "href"
            ]
          }
        }
      ]
    },
    "Options": {
      "description": "Widget-specific settings preserved for the corresponding widget implementation.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/ForbiddenKeyNames"
          },
          "properties": {
            "keyword_min_length": {
              "description": "Minimum search keyword length.",
              "$ref": "#/definitions/OpenValue"
            },
            "marker_draggable": {
              "description": "Whether the map marker can be dragged.",
              "$ref": "#/definitions/OpenValue"
            },
            "zoom": {
              "description": "Map zoom setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "geometry_type": {
              "description": "Geometry type setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "max_tags": {
              "description": "Maximum tag count.",
              "$ref": "#/definitions/OpenValue"
            },
            "checkbox_label": {
              "description": "Checkbox label content.",
              "$ref": "#/definitions/OpenValue"
            },
            "on_label": {
              "description": "Enabled toggle label content.",
              "$ref": "#/definitions/OpenValue"
            },
            "collapse": {
              "description": "Container collapse setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "expend": {
              "description": "Container expansion setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "view_total": {
              "description": "Container total display setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "stepper": {
              "description": "Container stepper setting.",
              "$ref": "#/definitions/OpenValue"
            },
            "blank_message": {
              "description": "Empty container message.",
              "$ref": "#/definitions/OpenValue"
            },
            "callback": {
              "description": "Opaque widget callback script.",
              "$ref": "#/definitions/OpenValue"
            },
            "event": {
              "description": "Opaque widget event setting.",
              "$ref": "#/definitions/OpenValue"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/OpenValue"
          }
        }
      ]
    },
    "ItemsModel": {
      "description": "Dynamic choice model descriptor with table, relations and display keys. The application executes data queries.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "properties": {
        "table": {
          "description": "Source table descriptor.",
          "type": "string"
        },
        "relations": {
          "description": "Source relation descriptors.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenValue"
          }
        },
        "keys": {
          "description": "Fields used to construct choice labels.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenValue"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/OpenValue"
      }
    },
    "ItemsSource": {
      "description": "Dynamic choice source descriptor. The application loads records and executes source callbacks.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "properties": {
        "model": {
          "description": "Source model name or a descriptor containing table, relations and keys.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/ItemsModel"
            }
          ]
        },
        "method": {
          "description": "Source model method name.",
          "type": "string"
        },
        "table": {
          "description": "Source table descriptor.",
          "type": "string"
        },
        "relations": {
          "description": "Source relation descriptors.",
          "$ref": "#/definitions/OpenValue"
        },
        "api_server": {
          "description": "Opaque endpoint callback preserved for the application.",
          "type": "string"
        },
        "items": {
          "description": "Static initial choices within a dynamic source.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/OpenValue"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ItemLabel"
              },
              "propertyNames": {
                "$ref": "#/definitions/ForbiddenKeyNames"
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/OpenValue"
      }
    },
    "Items": {
      "description": "Static choice array, value-to-label map or dynamic source descriptor. Labels may contain translations.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenValue"
          }
        },
        {
          "$ref": "#/definitions/ItemsSource"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ItemLabel"
          },
          "propertyNames": {
            "$ref": "#/definitions/ForbiddenKeyNames"
          }
        }
      ]
    },
    "LangOverrideMap": {
      "description": "Language-code map containing per-language validation, appearance, behavior and widget-option overrides.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "$ref": "#/definitions/ForbiddenKeyNames"
        },
        "properties": {
          "validate": {
            "description": "Validation rules.",
            "$ref": "#/definitions/Validate"
          },
          "design": {
            "description": "Visibility and node appearance settings.",
            "$ref": "#/definitions/Design"
          },
          "behavior": {
            "description": "Opaque behavior scripts.",
            "$ref": "#/definitions/Behavior"
          },
          "options": {
            "description": "Widget-specific settings.",
            "$ref": "#/definitions/Options"
          }
        }
      }
    },
    "Lang": {
      "description": "Language input settings, separate from content translations. Values are stored by language code.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "Language input mode.",
              "type": "string"
            },
            "only": {
              "description": "Language-code list or per-language override map.",
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "$ref": "#/definitions/LangOverrideMap"
                }
              ]
            },
            "name": {
              "description": "Language group name.",
              "type": "string"
            },
            "key": {
              "description": "Language group key.",
              "type": "string"
            },
            "frame": {
              "description": "Language group frame setting.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": {
              "description": "Language group title setting.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/Content"
                }
              ]
            },
            "group_class": {
              "description": "Language group CSS classes.",
              "type": "string"
            }
          }
        }
      ]
    },
    "Multiple": {
      "description": "Repeated rows use keyed instance data. Repetition options belong under multiple; row identity is carried by collection keys, without hidden identity fields.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "description": "Minimum repeated row count.",
              "type": "number"
            },
            "max": {
              "description": "Maximum repeated row count.",
              "type": "number"
            },
            "copy": {
              "description": "Whether repeated rows provide a copy control.",
              "type": "boolean"
            },
            "sortable": {
              "description": "Whether repeated rows can be reordered.",
              "type": "boolean"
            },
            "title": {
              "description": "Direct child field of a repeated group whose value titles each row.",
              "type": "string"
            },
            "controls": {
              "description": "Position of row controls.",
              "enum": [
                "header",
                "footer",
                "outline"
              ]
            },
            "header": {
              "description": "Whether row headers stay visible while scrolling.",
              "enum": [
                "static",
                "sticky"
              ]
            },
            "onclick": {
              "description": "Opaque repeated-row button action.",
              "$ref": "#/definitions/BehaviorAction"
            }
          }
        }
      ]
    },
    "Patch": {
      "description": "Composition operations for adding, removing or replacing definition properties.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "additionalProperties": {
        "$ref": "#/definitions/OpenValue"
      }
    },
    "Properties": {
      "description": "Child field map supporting composition references and patches. Child names must satisfy the property-name rules.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/ForbiddenKeyNames"
      },
      "properties": {
        "$ref": {
          "description": "Composition reference resolved before evaluation.",
          "type": "string"
        },
        "$patch": {
          "$ref": "#/definitions/Patch"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/Field"
      }
    },
    "Field": {
      "description": "Field declaration with structure, content, validation, appearance, behavior, type options and composition. Unrecognized field properties are rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Field widget type.",
          "type": "string"
        },
        "name": {
          "description": "Field name.",
          "type": "string"
        },
        "default": {
          "description": "Default value used when a field value is absent.",
          "$ref": "#/definitions/OpenValue"
        },
        "properties": {
          "description": "Nested field definitions.",
          "$ref": "#/definitions/Properties"
        },
        "items": {
          "description": "Static choices or a dynamic choice source descriptor.",
          "$ref": "#/definitions/Items"
        },
        "multiple": {
          "description": "Repeated rows use keyed instance data. Repetition options belong under multiple; row identity is carried by collection keys, without hidden identity fields.",
          "$ref": "#/definitions/Multiple"
        },
        "lang": {
          "description": "Language input configuration.",
          "$ref": "#/definitions/Lang"
        },
        "label": {
          "description": "Display label, optionally translated.",
          "$ref": "#/definitions/Content"
        },
        "description": {
          "description": "Description content, optionally translated.",
          "$ref": "#/definitions/Content"
        },
        "placeholder": {
          "description": "Placeholder text.",
          "$ref": "#/definitions/Content"
        },
        "prepend": {
          "description": "Content before the input.",
          "$ref": "#/definitions/Content"
        },
        "append": {
          "description": "Content after the input.",
          "$ref": "#/definitions/Content"
        },
        "help": {
          "description": "Help content, optionally translated.",
          "$ref": "#/definitions/Content"
        },
        "validate": {
          "description": "Validation rules.",
