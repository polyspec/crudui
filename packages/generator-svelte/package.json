{
  "name": "@polyspec/generator-svelte",
  "version": "1.0.0",
  "description": "Svelte form builder component library based on polyspec YAML definitions",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:v2": "vitest run test/v2-render.conformance.test.mjs test/v2-list-render.conformance.test.mjs",
    "test:v2-list": "vitest run test/v2-list-render.conformance.test.mjs",
    "test:watch": "vitest"
  },
  "keywords": [
    "svelte",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation",
    "limepie"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@polyspec/generator-core": "file:../generator-core",
    "@polyspec/validator": "file:../validator-ts",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "parse5": "^8.0.1",
    "svelte": "^5.56.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
