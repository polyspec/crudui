{
  "name": "@crudui/generator-svelte",
  "version": "0.0.1",
  "description": "Svelte form builder component library based on crudui YAML definitions",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/package-dist.mjs build 'svelte-package -i src -o dist'",
    "test": "node ../../scripts/run-tests.mjs vitest --cwd packages/generator-svelte && node ../../scripts/run-tests.mjs vitest --cwd packages/generator-svelte --config vitest.client.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "svelte",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@crudui/generator-core": "0.0.1"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "parse5": "^8.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
