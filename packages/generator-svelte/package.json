{
  "name": "@form-spec/generator-svelte",
  "version": "0.0.1",
  "description": "Svelte form builder component library based on form-spec YAML definitions",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "svelte": "./src/legacy/index.ts",
      "import": "./dist/legacy/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "svelte",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation",
    "limepie"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@form-spec/validator": "file:../validator-js",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "parse5": "^7.1.2",
    "svelte": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
