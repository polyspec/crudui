{
  "name": "@crudui/generator-svelte",
  "version": "0.0.1",
  "description": "Svelte form builder component library based on crudui YAML definitions",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "svelte": "./dist/legacy/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run && npm run test:client",
    "test:current": "vitest run test/form-render.conformance.test.mjs test/list-render.conformance.test.mjs",
    "test:list": "vitest run test/list-render.conformance.test.mjs",
    "test:watch": "vitest",
    "test:client": "vitest run --config vitest.client.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "svelte",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation",
    "legacy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@crudui/generator-core": "0.0.1",
    "@crudui/validator": "0.0.1",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "parse5": "^8.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
