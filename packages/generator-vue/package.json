{
  "name": "@crudui/generator-vue",
  "version": "0.0.1",
  "description": "Vue 3 form builder component library based on crudui YAML definitions",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean --external vue && tsc --project tsconfig.build.json",
    "dev": "tsup src/index.ts --format cjs,esm --watch --external vue --onSuccess \"tsc --project tsconfig.build.json\"",
    "test": "node ../../scripts/run-tests.mjs vitest --cwd packages/generator-vue",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vue",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@crudui/generator-core": "0.0.1",
    "@crudui/validator": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "parse5": "^8.0.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
