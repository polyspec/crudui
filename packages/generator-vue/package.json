{
  "name": "@polyspec/generator-vue",
  "version": "1.0.0",
  "description": "Vue 3 form builder component library based on form-spec YAML definitions (PHP Limepie parity)",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external vue",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external vue",
    "test": "vitest run",
    "test:v2": "vitest run test/v2-render.conformance.test.mjs test/v2-list-render.conformance.test.mjs",
    "test:v2-list": "vitest run test/v2-list-render.conformance.test.mjs"
  },
  "keywords": [
    "vue",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation",
    "limepie"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@polyspec/generator-core": "file:../generator-core",
    "@polyspec/validator": "file:../validator-ts",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vue/server-renderer": "^3.4.0",
    "parse5": "^8.0.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
