{
    "name": "polyspec/validator",
    "description": "PHP validator for polyspec system - validates form data against YAML specifications",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Polyspec Team"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Validator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:v2": "phpunit tests/V2"
    },
    "minimum-stability": "stable"
}
