{
    "name": "crudui/validator",
    "description": "PHP validator for crudui system - validates form data against YAML specifications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "CRUDUI Team"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CRUDUI\\Validator\\": "src/",
            "CRUDUI\\": "src/Public/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CRUDUI\\Validator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:current": "phpunit tests/Compose tests/Expr tests/Validate tests/FieldSpecTest.php"
    },
    "minimum-stability": "stable"
}
