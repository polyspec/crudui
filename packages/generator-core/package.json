{
  "name": "@polyspec/crudui-generator-core",
  "version": "0.0.4",
  "description": "Shared form compilation, data binding, expression evaluation and list models",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    },
    "./crudui.css": "./styles/crudui.css",
    "./crudui.tailwind.css": "./styles/crudui.tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "scripts": {
    "build": "node ../../scripts/package-dist.mjs build 'tsup src/index.ts src/internal.ts --format cjs,esm --splitting --clean --out-dir \"$CRUDUI_DIST\" && tsc --project tsconfig.build.json --outDir \"$CRUDUI_DIST\"'",
    "dev": "tsup src/index.ts src/internal.ts --format cjs,esm --splitting --watch --onSuccess \"tsc --project tsconfig.build.json\"",
    "test": "node ../../scripts/kit/run-tests.mjs vitest --cwd packages/generator-core",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@polyspec/crudui-validator": "0.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  }
}
