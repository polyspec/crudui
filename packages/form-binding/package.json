{
  "name": "@crudui/form-binding",
  "version": "0.0.1",
  "description": "Browser validation of server-rendered CRUDUI forms",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/package-dist.mjs build 'tsup src/index.ts --format esm --clean && tsc --project tsconfig.build.json'",
    "test": "node ../../scripts/run-tests.mjs vitest --cwd packages/form-binding",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["form", "validation", "browser", "yaml"],
  "license": "MIT",
  "dependencies": {
    "@crudui/validator": "0.0.1"
  },
  "devDependencies": {
    "@crudui/generator-core": "0.0.1",
    "@crudui/generator-html": "0.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "repository": { "type": "git", "url": "" },
  "bugs": { "url": "" }
}
