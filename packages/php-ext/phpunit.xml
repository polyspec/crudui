<?xml version="1.0" encoding="UTF-8"?>
<!--
  The PHPUnit suite of the PHP API of the extension: each runtime runs in a child process, the extension module that
  PHP_EXTENSION names or the PHP library, so this process loads neither.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         cacheDirectory="../../var/phpunit/php-ext">
    <testsuites>
        <testsuite name="php-ext">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
