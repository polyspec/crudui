{
    "name": "polyspec/crudui-generator",
    "description": "Form templates, editable data and HTML rendering for CRUDUI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-64bit": "^8.2",
        "ext-mbstring": "*",
        "polyspec/crudui-validator": "0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.1"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Crudui\\Generator\\": "src/Internal/",
            "Polyspec\\Crudui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Crudui\\Generator\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../validator-php",
            "options": {
                "symlink": false,
                "versions": {
                    "polyspec/crudui-validator": "0.0.1"
                }
            }
        }
    ],
    "scripts": {
        "test": "node ../../scripts/run-tests.mjs phpunit --cwd packages/generator-php"
    }
}
