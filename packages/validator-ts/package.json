{
  "name": "@polyspec/validator",
  "version": "1.0.0",
  "description": "Form validation library based on polyspec YAML definitions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "test:v2": "vitest run src/v2",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "bench": "tsx benchmarks/index.ts"
  },
  "keywords": [
    "form",
    "validation",
    "validator",
    "yaml",
    "spec",
    "limepie"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.3.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  }
}
