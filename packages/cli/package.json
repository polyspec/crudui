{
  "name": "@polyspec/crudui-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Specification catalog, static checking and descriptions for CRUDUI.",
  "type": "module",
  "bin": {
    "crudui": "bin/crudui.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "describe": "node --import tsx bin/crudui.mjs describe",
    "test": "node ../../scripts/require-current-build.mjs && node ../../scripts/run-tests.mjs vitest --cwd packages/cli"
  },
  "dependencies": {
    "@polyspec/crudui-generator-core": "0.0.1",
    "@polyspec/crudui-validator": "0.0.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
