    "@polyspec/crudui-validator": "0.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
