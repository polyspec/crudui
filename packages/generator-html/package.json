{
  "name": "@crudui/generator-html",
  "version": "0.0.1",
  "description": "Framework-independent CRUDUI form and list HTML renderer",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "node ../../scripts/package-dist.mjs build 'tsup src/index.ts --format cjs,esm --clean && tsc --project tsconfig.build.json'",
    "dev": "tsup src/index.ts --format cjs,esm --watch --onSuccess \"tsc --project tsconfig.build.json\"",
    "test": "node ../../scripts/run-tests.mjs vitest --cwd packages/generator-html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["form", "html", "renderer", "yaml"],
  "license": "MIT",
  "dependencies": {
    "@crudui/generator-core": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": { "node": ">=16.0.0" },
  "repository": { "type": "git", "url": "" },
  "bugs": { "url": "" }
}
