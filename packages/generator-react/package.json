{
  "name": "@polyspec/crudui-generator-react",
  "version": "0.0.2",
  "description": "React form builder component library based on crudui YAML definitions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/package-dist.mjs build 'tsup src/index.ts src/server.ts --format cjs,esm --clean --external react --external react-dom --out-dir \"$CRUDUI_DIST\" && tsc --project tsconfig.build.json --outDir \"$CRUDUI_DIST\"'",
    "dev": "tsup src/index.ts src/server.ts --format cjs,esm --watch --external react --external react-dom --onSuccess \"tsc --project tsconfig.build.json\"",
    "test": "node ../../scripts/run-tests.mjs vitest --cwd packages/generator-react",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "form",
    "form-builder",
    "yaml",
    "spec",
    "validation"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@polyspec/crudui-generator-core": "0.0.2"
  },
  "devDependencies": {
    "@polyspec/crudui-generator-html": "0.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  }
}
