{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "../packages/generator-svelte/src/render.ts",
    "../packages/generator-svelte/src/fieldHtml.ts",
    "../packages/generator-svelte/src/i18n.ts",
    "../packages/generator-svelte/src/legacyDisplay.ts",
    "../packages/generator-svelte/src/legacyLang.ts",
    "../packages/generator-svelte/src/utils.ts"
  ]
}
