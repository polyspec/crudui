{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "gitRevision": "main",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/crudui/crudui/blob/main/{path}#L{line}",
  "includeVersion": false,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "useCodeBlocks": true,
  "sanitizeComments": true,
  "expandObjects": false,
  "hidePageHeader": false,
  "hideBreadcrumbs": false,
  "publicPath": "/api/",
  "sort": ["source-order"]
}
