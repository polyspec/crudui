    { "paths": ["packages/validator-{go,rust}/**"], "targets": ["test-validators"], "prefixes": ["examples/cross-check-console/server"] },
    { "paths": ["packages/generator-core/**"], "workspaces": ["@polyspec/crudui-generator-core"], "scripts": ["test:forms"] },
