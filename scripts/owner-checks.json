    "npm run test:forms": ["packages/generator-{core,html,react,vue,svelte}/**", "packages/form-binding/**", "packages/validator-ts/**", "tests/fixtures/**", "tests/*.test.mjs", "tests/browser-engines.*", "examples/product-forms/**"],
    "npm run test:form-comparison": ["examples/form-comparison/**"],
