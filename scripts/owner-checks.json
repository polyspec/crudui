    { "paths": ["packages/generator-vue/**"], "workspaces": ["@polyspec/crudui-generator-vue"], "scripts": ["test:forms"] },
    { "paths": ["packages/generator-svelte/**"], "workspaces": ["@polyspec/crudui-generator-svelte"], "scripts": ["test:forms"] },
    { "paths": ["packages/form-binding/**"], "targets": ["test-form-binding"], "scripts": ["test:forms"] },
    { "paths": ["packages/cli/**"], "workspaces": ["@polyspec/crudui-cli"] },
