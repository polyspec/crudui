    { "paths": ["schema/crudui.schema.json", "scripts/check-schema.mjs", "examples/form-structure/**"], "targets": ["docs-schema", "test-validators"] },
    { "paths": ["packages/validator-ts/**"], "workspaces": ["@polyspec/crudui-validator"], "scripts": ["test:forms"], "prefixes": ["examples/cross-check-console/server"] },
