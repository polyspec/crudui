    { "paths": ["scripts/require-current-build.mjs", "scripts/run-command.mjs"], "tests": ["tests/build/run-command.test.mjs", "tests/build/atomic-publish.test.mjs"] },
    { "paths": ["scripts/install-npm.mjs", "scripts/checkout-npm.mjs"], "tests": ["tests/build/checkout-npm.test.mjs", "tests/build/runtime-version-policy.test.mjs"] },
    { "paths": ["scripts/install-browsers.mjs", "scripts/check-ci-browser.mjs"], "tests": ["tests/build/install-browsers.test.mjs", "tests/build/ci-browser.test.mjs", "tests/build/form-comparison-ci.test.mjs", "tests/build/runtime-version-policy.test.mjs"] },
