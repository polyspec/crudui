{
  "comment": "The owner checks of the repository paths, read by scripts/owner-check.mjs: make owner-check runs the make targets (targets), the root npm scripts (scripts), the test scripts of workspaces (workspaces) and of package directories (prefixes) and the node test files (tests; $path is the changed test file) of the rules whose globs match a changed path. Every tracked path matches a rule; always lists the tests that run for every change. inputs declares, for a check named as make <target>, npm run <script>, npm test -w <workspace> or npm test --prefix <directory>, the globs of the paths that it reads; the owner check fails when a rule of such a path does not select that check. Globs: * within one path segment, ** across segments, {a,b} either alternative.",
  "always": ["tests/build/test-commands.test.mjs", "tests/build/package-names.test.mjs"],
  "owners": [
    { "paths": ["*.md", "docs/**", "contracts/README*.md", "schema/README*.md", "examples/**/README*.md", "tests/**/README*.md", "tools/bench/README.md", "packages/**/README*.md"], "targets": ["docs-check"] },
    { "paths": ["contracts/features.json", "contracts/features.schema.json", "scripts/check-contract-manifest.mjs", "scripts/generate-feature-contract-docs.mjs", "scripts/run-contract-tests.mjs"], "scripts": ["manifest:check", "manifest:docs:check"], "tests": ["tests/build/contract-manifest.test.mjs", "tests/build/run-command.test.mjs"] },
