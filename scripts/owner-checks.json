    { "paths": ["scripts/release.mjs"], "tests": ["tests/build/release.test.mjs", "tests/build/ci-local.test.mjs"] },
    { "paths": ["Makefile"], "tests": ["tests/build/offline-checks.test.mjs", "tests/build/make-dry-run.test.mjs", "tests/build/full-run.test.mjs", "tests/build/push-gate.test.mjs", "tests/build/make-tool-path.test.mjs", "tests/build/php-extensions.test.mjs", "tests/build/checkout-npm.test.mjs", "tests/build/runtime-version-policy.test.mjs", "tests/build/ci-local.test.mjs", "tests/build/owner-check.test.mjs"] },
    { "paths": [".github/workflows/**"], "tests": ["tests/build/ci-local.test.mjs", "tests/build/runtime-version-policy.test.mjs", "tests/build/form-comparison-ci.test.mjs", "tests/build/checkout-npm.test.mjs", "tests/build/push-gate.test.mjs"] },
