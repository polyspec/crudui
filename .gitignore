# Dependencies
node_modules/
# Workspace packages use the root dependency lock file.
packages/*/package-lock.json

# Composer dependencies
examples/**/vendor/
packages/validator-php/vendor/
packages/generator-php/vendor/
packages/generator-php/.phpunit.cache/
packages/generator-php/.phpunit.result.cache

# Build outputs
dist/
.svelte-kit/
*.tsbuildinfo

# Rust build outputs (Cargo.lock is committed for the binary crate)
target/

# Compiled Go validator process of the cross-check console
examples/cross-check-console/validators/go/validate

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
test-*.js
test-*.html

# Environment
.env
.env.local
.history

# Generated documentation (reproducible via `make docs` — do not commit)
# Static site output and generated API trees are regenerated on every run.
docs/.site/
docs/api/
docs/public/api/
# phpDocumentor phar + cache (large, environment-local)
tools/bin/phpDocumentor.phar
tools/bin/.phpdoc-cache/

# Local verification reports
.verification/
.form-comparison/

# Clang static analyzer reports (macOS)
/*.plist
