# Dependencies
node_modules/
# The browsers of this checkout (scripts/install-browsers.mts)
/.tools/
# Workspace packages use the root dependency lock file.
packages/**/package-lock.json
!packages/svelte/tools/package-lock.json

# Composer dependencies
examples/**/vendor/
/vendor/
packages/generator/php/.phpunit.cache/
packages/generator/php/.phpunit.result.cache

# The temporary API reports of API Extractor in each package (make lint-ts)
packages/**/var/

# Build outputs; a package build writes dist.next and replaces dist with it (scripts/package-dist.mts)
dist/
dist.next/
dist.old/
.svelte-kit/
*.tsbuildinfo

# Rust build outputs (Cargo.lock is committed for the binary crate)
target/

# Python bytecode of the test runs
__pycache__/

# The metadata that setuptools writes next to the sources of a package that make crudui-install-python installs in editable
# mode
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
test-*.js
test-*.html

# Environment
.env
.env.local
.history

# Generated documentation (reproducible via `make docs` — do not commit)
# Static web output and generated API trees are regenerated on every run.
docs/.web/
docs/api/
docs/public/api/

# The tools (make install-tools), locks, records and reports of this checkout
/var/

# Local verification reports
.verification/
.form-comparison/

# Clang static analyzer reports (macOS)
/*.plist

# Generated files of the install, build, cache and test runs (AGENTS.md, Generated files)
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.phpunit.cache/
.phpunit.result.cache
test-results/
playwright-report/
coverage/

# The workspace files that make link writes beside each Go module; the go.work of the repository root is tracked
go.work.sum
/benchmarks/validators/go/go.work
/tests/native-generators/programs/go/go.work
/examples/cross-check-console/validators/go/go.work
/examples/form-comparison/servers/go/go.work
/packages/validator/go/go.work
/packages/generator/go/go.work
