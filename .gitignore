# Dependencies
node_modules/

# Example app PHP dependencies (validator-php ships vendored, examples do not)
examples/**/vendor/

# Build outputs
dist/
*.tsbuildinfo

# Rust build outputs (Cargo.lock is committed for the binary crate)
target/

# Compiled example Go server binaries
examples/go-api/go-api
# Compiled current validator Go CLI binary (built by cross-check-console build step)
packages/validator-go/validate

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
test-*.js
test-*.html

# Environment
.env
.env.local
.history

# Generated documentation (reproducible via `make docs` — do not commit)
# VitePress build output, cache, and generated API trees are regenerated on
# every run and must not be committed (only docs/.vitepress/config.mts is source).
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/api/
# Generated JSON Schema (reproducible via `make docs-schema`)
schema/crudui.schema.json
# phpDocumentor phar + cache (large, environment-local)
tools/bin/phpDocumentor.phar
tools/bin/.phpdoc-cache/
# current corpus measurement artifacts (reproducible via scripts/corpus-legacy-run.mts against the specification corpus)
scripts/corpus-legacy-result.json
scripts/corpus-legacy-classified.json
scripts/corpus-legacy-verify.json

# Local form comparison containers, source archives and JSON records
.form-comparison/
