# Dependencies
node_modules/
# The npm of this checkout (scripts/install-npm.mjs)
/.tools/
# Workspace packages use the root dependency lock file.
packages/*/package-lock.json

# Composer dependencies
examples/**/vendor/
/vendor/
packages/generator-php/.phpunit.cache/
packages/generator-php/.phpunit.result.cache

# Build outputs; a package build writes dist.next and replaces dist with it (scripts/package-dist.mjs)
dist/
dist.next/
dist.old/
.svelte-kit/
*.tsbuildinfo

# Rust build outputs (Cargo.lock is committed for the binary crate)
target/

# Python bytecode of the test runs
__pycache__/

# Compiled Go validator process of the cross-check console
examples/cross-check-console/validators/go/validate

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
test-*.js
test-*.html

# Environment
.env
.env.local
.history

# Generated documentation (reproducible via `make docs` — do not commit)
# Static web output and generated API trees are regenerated on every run.
docs/.web/
docs/api/
docs/public/api/
# phpDocumentor phar + cache (large, environment-local)
tools/bin/phpDocumentor.phar
tools/bin/.phpdoc-cache/

# Holder locks of this checkout (scripts/holder-lock.mjs)
/var/

# Local verification reports
.verification/
.form-comparison/

# Clang static analyzer reports (macOS)
/*.plist
