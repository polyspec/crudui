{
  "name": "form-spec",
  "version": "0.0.1",
  "private": true,
  "description": "YAML-based form generation and validation system (Multi-language, Multi-framework)",
  "main": "capture-react.js",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build -w @form-spec/validator && npm run build -w @form-spec/generator-react",
    "test": "node tests/runner/compare-all.js",
    "lint": "eslint packages/validator-js/src packages/generator-react/src --ext .ts,.tsx",
    "lint:fix": "eslint packages/validator-js/src packages/generator-react/src --ext .ts,.tsx --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyspec/crudui.git"
  },
  "keywords": [
    "form",
    "validation",
    "yaml",
    "react",
    "typescript",
    "form-builder"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/polyspec/crudui/issues"
  },
  "homepage": "https://github.com/polyspec/crudui#readme",
  "dependencies": {
    "puppeteer": "^24.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "debug": "^4.4.3",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
