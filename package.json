{
  "name": "form-spec",
  "version": "0.0.1",
  "private": true,
  "description": "YAML-based form generation and validation system (Multi-language, Multi-framework)",
  "main": "capture-react.js",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:validator && npm run build:generators",
    "build:validator": "npm run build -w @crudui/validator",
    "build:generators": "npm run build -w @crudui/generator-core && npm run build -w @crudui/generator-react && npm run build -w @crudui/generator-vue && npm run build -w @crudui/generator-svelte",
    "test": "node tests/runner/compare-all.js",
    "lint": "eslint packages/validator-ts/src packages/generator-react/src",
    "lint:fix": "eslint packages/validator-ts/src packages/generator-react/src --fix",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/check-doc-coverage.mjs",
    "docs:check:ts": "node scripts/check-doc-coverage.mjs ts",
    "docs:check:servers": "node scripts/check-server-doc-coverage.mjs",
    "docs:check:all": "npm run docs:check && npm run docs:check:servers",
    "spec:schema": "node scripts/gen-schema.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crudui/crudui.git"
  },
  "keywords": [
    "form",
    "validation",
    "yaml",
    "react",
    "typescript",
    "form-builder"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/crudui/crudui/issues"
  },
  "homepage": "https://github.com/crudui/crudui#readme",
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "debug": "^4.4.3",
    "eslint": "^10.5.0",
    "js-yaml": "^4.2.0",
    "mermaid": "^11.15.0",
    "ts-json-schema-generator": "^2.9.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript-eslint": "^8.61.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
