{
  "name": "crudui",
  "version": "0.0.1",
  "private": true,
  "description": "YAML-based form generation and validation system (Multi-language, Multi-framework)",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:validator && npm run build:generators",
    "build:validator": "npm run build -w @crudui/validator",
    "build:generators": "npm run build -w @crudui/generator-core && npm run build -w @crudui/generator-html && npm run build -w @crudui/generator-react && npm run build -w @crudui/generator-vue && npm run build -w @crudui/generator-svelte",
    "test": "node --test tests/runner/compare-all.test.cjs && node tests/runner/compare-all.js",
    "lint": "eslint packages/validator-ts/src packages/generator-html/src packages/generator-react/src",
    "lint:fix": "eslint packages/validator-ts/src packages/generator-html/src packages/generator-react/src --fix",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:prepare": "npm run manifest:docs && npm run docs:api && npm run spec:schema",
    "docs:build": "npm run docs:prepare && node scripts/docs-site/cli.mjs build",
    "docs:dev": "npm run docs:prepare && node scripts/docs-site/cli.mjs dev",
    "docs:preview": "npm run docs:prepare && node scripts/docs-site/cli.mjs preview",
    "docs:check": "node scripts/check-doc-coverage.mjs",
    "docs:check:ts": "node scripts/check-doc-coverage.mjs ts",
    "docs:check:servers": "node scripts/check-server-doc-coverage.mjs",
    "docs:check:all": "npm run manifest:check && npm run manifest:docs:check && npm run docs:check:documents && npm run docs:check && npm run docs:check:servers",
    "manifest:check": "node scripts/check-contract-manifest.mjs",
    "manifest:docs": "node scripts/generate-feature-contract-docs.mjs",
    "manifest:docs:check": "node scripts/generate-feature-contract-docs.mjs --check",
    "manifest:test": "npm run build && node scripts/run-contract-tests.mjs",
    "spec:schema": "node scripts/check-schema.mjs",
    "test:forms": "npm run build:validator && npm run build:generators && npm test -w @crudui/generator-core -- --run && npm test -w @crudui/generator-html -- --run && npm test -w @crudui/generator-react -- --run && npm test -w @crudui/generator-vue && npm test -w @crudui/generator-svelte && node --test tests/fixtures/form-render/normalize.test.mjs tests/form-styles.test.mjs tests/form-markup/naming.test.mjs",
    "test:form-comparison": "npm run test:form-comparison:build && npm run test:form-comparison:browser",
    "test:form-comparison:build": "npm run test:form-comparison:source && npm run test:form-comparison:library",
    "test:form-comparison:source": "node --test examples/form-comparison/browser-report.test.mjs examples/form-comparison/check-*.test.mjs examples/form-comparison/prepare.test.mjs examples/form-comparison/public/*.test.mjs examples/form-comparison/src/*.test.mjs",
    "test:form-comparison:browser": "node --test examples/form-comparison/src/browser-job.browser.mjs",
    "test:form-comparison:library": "node --test examples/form-comparison/generation-performance.test.mjs",
    "docs:check:documents": "node scripts/check-documents.mjs",
    "test:packages": "npm run build && node scripts/check-packages.mjs",
    "test:dependencies": "node --test tests/build/dependency-health.test.mjs",
    "test:runtimes": "node --test tests/build/runtime-version-policy.test.mjs tests/build/form-comparison-ci.test.mjs tests/build/make-tool-path.test.mjs tests/build/rust-node-entry-points.test.mjs",
    "test:docs": "node --test tests/docs/*.test.mjs",
    "test:build": "node --test tests/build/public-packages.test.mjs tests/build/vite-config.test.mjs",
    "test:build:repeat": "node --test tests/build/reproducible-build.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyspec/crudui.git"
  },
  "keywords": [
    "form",
    "validation",
    "yaml",
    "react",
    "typescript",
    "form-builder"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/polyspec/crudui/issues"
  },
  "homepage": "https://github.com/polyspec/crudui#readme",
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@crudui/generator-core": "0.0.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "debug": "^4.4.3",
    "eslint": "^10.5.0",
    "js-yaml": "^4.2.0",
    "jsdom": "29.1.1",
    "markdown-it": "15.0.1",
    "ordered-json": "https://codeload.github.com/ordered-json/javascript/tar.gz/d3b1f3473ce2645c79c772940df622c4d8b0bca7",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-json-schema-generator": "^2.9.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript-eslint": "^8.61.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.10.0": true,
    "fsevents@2.3.3": true
  }
}
